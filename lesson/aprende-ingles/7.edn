 :lesson/title "Iniciadores y verbos útiles",
 :lesson/target-title "Sentence starters and useful verbs",
 :lesson/label "Lección 7",
 :lesson/sections
 [{:section/type :communication-multiplied,
   :section/id 8,
   :section/title "Iniciadores de frases",
   :section/body
   ["I am sorry es un iniciador de frase: I am sorry, I can't help him today."
    "También puede ir solo: I am sorry."
    "Otras formas útiles: Excuse me y Pardon me."
    "Los iniciadores te dan tiempo para pensar y suavizan lo que dices."]}
  {:section/type :accuracy-pointer,
   :section/id 5,
   :section/title "Spend: tiempo y dinero",
   :section/body
   ["En inglés spend se usa con tiempo y con dinero: spend time, spend money."
    "I spend time = paso tiempo; I spend money = gasto dinero."
    "El verbo cambia de significado según la palabra que lo acompaña."]}
  {:section/type :accuracy-pointer,
   :section/id 6,
   :section/title "Drink: beber o tomar",
   :section/body
   ["Para beber, el inglés usa drink: I drink water."
    "take a drink = tomar algo; drink es el verbo general."
    "No confundas drink con eat."]}],
 :lesson/number 7,
