 :lesson/label "Lección 4",
 :lesson/sections
 [{:section/type :communication-multiplied,
   :section/id nil,
   :section/title "Palabras de tiempo y preposiciones",
   :section/body
   ["Las palabras de tiempo suelen ir con the o con una preposición: in the morning, in the afternoon."
    "En inglés, the no cambia: the morning, the afternoon, the night."
    "Por la noche se dice at night, no *in the night*."
    "Con this y next no usas preposición: this week, next week."]}],
 :lesson/number 4,
 :lesson/intro [],
 :lesson/step {:step/number 1, :step/title "Primeros pasos para hablar inglés"},
 :lesson/closing
 ["Ya tienes las palabras para moverte por el día, la semana y el mes."
  "Úsalas en frases completas: I am going to work this afternoon."
  "La práctica constante hará que las uses sin pensar."],
