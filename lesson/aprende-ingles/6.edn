  {:exercise/id "6B",
   :exercise/skill :translate,
   :exercise/direction :to-base,
   :exercise/dialog? false,
   :exercise/instructions "Traduce estas frases al español.",
   :exercise/hints ["from/of = de" "school = Escuela"],
   :exercise/items
   [{:item/n 1,
     :item/prompt ["I am going to visit Barbara today."],
     :item/answer ["Voy a visitar a Bárbara hoy."]}
    {:item/n 2,
     :item/prompt ["I have to study a lot for the exam."],
     :item/answer ["Tengo que estudiar mucho para el examen."]}
    {:item/n 3,
     :item/prompt
     ["I would like to eat in this restaurant again tomorrow night. (tomorrow in the night)"],
     :item/answer ["Me gustaría comer en este restaurante otra vez mañana en la noche."]}
    {:item/n 4,
     :item/prompt ["I can help him a lot with the vocabulary in Spanish."],
     :item/answer ["Puedo ayudarlo mucho con el vocabulario en español."]}
    {:item/n 5,
     :item/prompt ["I am going to speak a lot of Spanish in my vacation."],
     :item/answer ["Voy a hablar mucho español en mis vacaciones."]}
    {:item/n 6,
     :item/prompt ["I have to call my wife today."],
     :item/answer ["Tengo que llamar a mi esposa hoy."]}
    {:item/n 7,
     :item/prompt ["On the weekend I would like to go to a bar with my friends. *"],
     :item/answer ["El fin de semana me gustaría ir a un bar con mis amigos."]}
    {:item/n 8,
     :item/prompt ["I don’t have to work this month, I am going to be on vacation."],
     :item/answer ["No tengo que trabajar este mes,voy a estar de vacaciones."]}
    {:item/n 9,
     :item/prompt ["I have to return the video tomorrow night. (tomorrow in the night)."],
     :item/answer ["Tengo que regresar el video mañana en la noche."]}
    {:item/n 10,
     :item/prompt ["I would like to eat something different today."],
     :item/answer ["Me gustaría comer algo diferente hoy."]}
    {:item/n 11,
     :item/prompt ["I am going to invite a lot of friends to the party this weekend."],
     :item/answer ["Voy a invitar a muchos amigos a la fiesta este fin de semana."]}
    {:item/n 12,
     :item/prompt ["I am going to go to the island this weekend."],
     :item/answer ["Voy a ir a la isla este fin de semana."]}
    {:item/n 13,
     :item/prompt ["I am going to study Spanish in a school for 3 months."],
     :item/answer ["Voy a estudiar español en una escuela por tres meses."]}
    {:item/n 14,
     :item/prompt ["Tomorrow night I would like to eat in the restaurant with my friends."],
     :item/answer ["Mañana en la noche, me gustaría comer en el restaurante con mis amigos."]}
    {:item/n 15,
     :item/prompt ["I have to go to the doctor today."],
     :item/answer ["Tengo que ir al doctor hoy."]}
    {:item/n 16,
     :item/prompt ["I am going to be in Honduras for two years."],
     :item/answer ["Voy a estar en Honduras por dos años."]}
    {:item/n 17,
     :item/prompt ["I want to rent a house in Puerto Vallarta this year."],
     :item/answer ["Quiero rentar una casa en Puerto Vallarta este año."]}
    {:item/n 18,
     :item/prompt ["I am going to see the Rolling Stones next weekend."],
     :item/answer ["Voy a ver los Rolling Stones el próximo fin de semana."]}
    {:item/n 19,
     :item/prompt ["This weekend and the next I need to study a lot."],
     :item/answer ["Este fin de semana y el próximo necesito estudiar mucho."]}
    {:item/n 20,
     :item/prompt ["I need a hotel for one month."],
     :item/answer ["Necesito un hotel por un mes."]}
    {:item/n 21,
     :item/prompt
     ["The next month, I am going to go to Cabo San Lucas with a group of friends from my school."],
     :item/answer
     ["El próximo mes, voy a ir a Cabo San Lucas con un grupo de amigos de mi escuela."]}
    {:item/n 22,
     :item/prompt ["I need to study a lot more in the Spanish school."],
     :item/answer ["Necesito estudiar mucho más en la escuela de español."]}
    {:item/n 23,
     :item/prompt ["I am going to study a lot in order to speak with you in Spanish."],
     :item/answer ["Voy a estudiar mucho para hablar con usted en español."]}
    {:item/n 24,
     :item/prompt ["Today I would like to go to the cinema."],
     :item/answer ["Hoy me gustaría ir al cine."]}
    {:item/n 25,
     :item/prompt ["I want to work in a hotel in Cancun this year."],
     :item/answer ["Quiero trabajar en un hotel en Cancún este año."]}
    {:item/n 26,
     :item/prompt ["I can’t return to Madrid until next month."],
     :item/answer ["No puedo regresar a Madrid hasta el próximo mes."]}
    {:item/n 27,
     :item/prompt
     ["I would like to eat traditional food today. * Note: In Spanish to say, on the weekend, you just say, el fin de semana."],
     :item/answer ["Me gustaría comer comida tradicional hoy."]}],
   :exercise/notes []}
