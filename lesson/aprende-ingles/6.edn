 :lesson/title "Esta semana y la próxima",
 :lesson/target-title "This week and next week",
 :lesson/label "Lección 6",
 :lesson/sections
 [{:section/type :communication-multiplied,
   :section/id 7,
   :section/title "This, next y el tiempo",
   :section/body
   ["Para hablar de tiempo usas this o next: this week, next week."
    "En inglés no hay género: this month, next year, this weekend."
    "weekend es una palabra compuesta: week + end."
    "Recuerda: this = este/esta; next = próximo/próxima."]}],
 :lesson/number 6,
