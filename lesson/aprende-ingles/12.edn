   :exercise/items
   [{:item/n 1,
     :item/prompt ["I can’t travel with him before December."],
     :item/answer ["No puedo viajar con él antes de diciembre."]}
    {:item/n 2,
     :item/prompt ["What do you want to do today? I want to go to the cinema."],
     :item/answer ["¿Qué quiere hacer hoy? Quiero ir al cine."]}
    {:item/n 3,
     :item/prompt ["I like to see my friends (on) the weekends."],
     :item/answer ["Me gusta ver a mis amigos los fines de semana."]}
    {:item/n 4,
     :item/prompt
     ["I like (to have breakfast) having breakfast in this restaurant (on) the weekends."],
     :item/answer ["Me gusta desayunar en este restaurante los fines de semana."]}
    {:item/n 5,
     :item/prompt ["You don't like football!"],
     :item/answer ["!No le gusta el fútbol!"]}
    {:item/n 6,
     :item/prompt ["What do you want to drink, tea or coffee?"],
     :item/answer ["¿Qué quiere tomar té o café?"]}
    {:item/n 7,
     :item/prompt ["I am going to return to the hotel before (to go) going to the restaurant."],
     :item/answer ["Voy a regresar al hotel antes de ir al restaurante."]}
    {:item/n 8,
     :item/prompt ["You can study here for a while before (to return) returning to your house."],
     :item/answer ["Puede estudiar aquí por un rato antes de regresar a su casa."]}
    {:item/n 9,
     :item/prompt ["I want to walk in the park."],
     :item/answer ["Quiero caminar en el parque."]}
    {:item/n 10,
     :item/prompt ["You have to finish before the weekend."],
     :item/answer ["Tiene que terminar antes del fin de semana."]}
    {:item/n 11,
     :item/prompt ["Are you going to return before the next year?"],
     :item/answer ["¿Va a regresar antes del próximo año?"]}
    {:item/n 12,
     :item/prompt ["You can walk with him to the hotel."],
     :item/answer ["Puede caminar con él al hotel."]}
    {:item/n 13,
     :item/prompt ["Do you like (to study) studying with him?"],
     :item/answer ["¿Le gusta estudiar con él?"]}
    {:item/n 14,
     :item/prompt ["I have to make a reservation."],
     :item/answer ["Tengo que hacer una reservación."]}
    {:item/n 15,
     :item/prompt ["I need to make a call right now."],
     :item/answer ["Necesito hacer una llamada ahora mismo."]}
    {:item/n 16,
     :item/prompt ["Can you help me before (to have breakfast) having breakfast?"],
     :item/answer ["¿Puede ayudarme antes de desayunar?"]}
    {:item/n 17,
     :item/prompt
     ["I would like to drink a coffee here before (to go back) going back to the hotel."],
     :item/answer ["Me gustaría tomar un café aquí antes de regresar al hotel."]}
    {:item/n 18,
     :item/prompt ["Why don't you like to travel?"],
     :item/answer ["¿Por qué no le gusta viajar?"]}
    {:item/n 19,
     :item/prompt ["I am going to spend a month there before the end of the year."],
     :item/answer ["Voy a pasar un mes allá antes del fin de año."]}
    {:item/n 20,
     :item/prompt ["You can’t walk, you need to go (in) by taxi."],
     :item/answer ["No puede caminar, necesita ir en taxi."]}
    {:item/n 21, :item/prompt ["I need to do a pee."], :item/answer ["Necesito hacer pipi."]}
    {:item/n 22,
     :item/prompt ["Do you like to go to the bars in Tijuana on the weekends?"],
     :item/answer ["¿Le gusta ir a los bares en Tijuana los fines de semana?"]}
    {:item/n 23,
     :item/prompt ["Do you like being (to be) home?"],
     :item/answer ["¿Le gusta estar en casa?"]}
    {:item/n 24,
     :item/prompt ["You need to do (to make) a double click here."],
     :item/answer ["Necesita hacer un doble clic aquí."]}
    {:item/n 25,
     :item/prompt ["Are you going to walk or are you going to take a taxi?"],
     :item/answer ["¿Va a caminar o va a tomar un taxi?"]}
    {:item/n 26,
     :item/prompt ["I don't want to make a comment."],
     :item/answer ["No quiero hacer un comentario."]}
    {:item/n 27,
     :item/prompt ["Do you like Mexican food?"],
     :item/answer ["¿Le gusta la comida mexicana?"]}
    {:item/n 28,
