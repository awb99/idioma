 :lesson/sections
 [{:section/type :communication-multiplied,
   :section/id 10,
   :section/title "Before + verbo",
   :section/body
   ["Con before puedes usar un verbo en -ing o un sustantivo: before having breakfast."
    "También puedes usar before + sujeto + verbo: before I have breakfast."
    "En inglés, after y before pueden ir seguidos de -ing cuando el sujeto es el mismo."
    "Before studying, I like to walk = antes de estudiar, me gusta caminar."]}],
 :lesson/number 12,
 :lesson/intro [],
 :lesson/step {:step/number 2, :step/title "Aprender a usar el diálogo"},
 :lesson/closing
 ["Enhorabuena, has terminado el paso 2."
  "En solo cuatro lecciones tu capacidad se ha multiplicado."
  "Intenta crear tus propias frases y imagina situaciones reales."
  "Dedica cinco minutos al día a pensar cómo dirías lo que quieres en inglés."
  "En la próxima lección entraremos en el territorio del plural."],
