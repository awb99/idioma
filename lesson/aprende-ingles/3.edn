 :lesson/title "Multiplica tu inglés",
 :lesson/target-title "Multiplying your English",
 :lesson/label "Lección 3",
 :lesson/sections
 [{:section/type :communication-multiplied,
   :section/id 3,
   :section/title "El futuro con going to",
   :section/body
   ["Para hablar del futuro usas be + going to + verbo: I am going to visit my friend."
    "Con he, she o it usa is: she is going to travel."
    "Con we, you o they usa are: we are going to eat."
    "El verbo que sigue a going to va en forma base: go, see, speak, visit."
    "I am going to go = voy a ir; I am going to see = voy a ver."]}
  {:section/type :accuracy-pointer,
   :section/id 2,
   :section/title "La terminación -ing",
   :section/body
   ["El final -ing se pronuncia «ing»: going suena como «góuin»."
    "La g final es suave; no la pronuncies como la g española."
    "Escucha y repite: going, eating, speaking."]}
  {:section/type :accuracy-pointer,
   :section/id 3,
   :section/title "La preposición to con personas",
   :section/body
   ["Con invite, visit, call o help, la persona va después del verbo, sin preposición: I am going to invite Diego."
    "No digas *I am going to invite to Diego*."
    "Con lugares sí usas to: I am going to visit Mexico."
    "En inglés, to solo aparece con lugares o dentro de going to."
    "Sé valiente: equivocarse es parte de aprender y la comunicación es lo primero."]}],
 :lesson/number 3,
 :lesson/intro [],
 :lesson/step {:step/number 1, :step/title "Primeros pasos para hablar inglés"},
 :lesson/closing
 ["Enhorabuena, has dado otro paso en tu inglés."
