 :lesson/title "Diálogos para conversar",
 :lesson/target-title "Dialog and conversation",
 :lesson/label "Lección 9",
 :lesson/sections
 [{:section/type :speaking-hints,
   :section/id nil,
   :section/title "Cómo usar los diálogos",
   :section/body
   ["En los diálogos verás dos o más intervenciones seguidas."
    "Traduce cada línea al idioma que indica el ejercicio, sin cambiar el orden."
    "Si una línea te bloquea, usa las pistas o muestra la respuesta y sigue con la siguiente."
    "El objetivo es entender la conversación completa, no cada palabra por separado."]}],
 :lesson/number 9,
 :lesson/intro [],
 :lesson/step {:step/number 2, :step/title "Aprender a usar el diálogo"},
 :lesson/closing
 ["Los diálogos son la mejor forma de ver el inglés en contexto real."
  "No te preocupes si no entiendes todo a la primera; usa las pistas y vuelve a intentarlo."
  "Cada diálogo te prepara para una conversación de verdad."],
