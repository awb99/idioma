  {:exercise/id "9E",
   :exercise/skill :translate,
   :exercise/direction :to-target,
   :exercise/dialog? true,
   :exercise/instructions "Traduce cada intervención del diálogo al inglés.",
   :exercise/hints [],
   :exercise/items
   [{:item/n 1,
     :item/prompt ["¿Cuándo necesita ver al doctor?" "Mañana."],
     :item/answer ["When do you need to see the doctor?" "Tomorrow."]}
    {:item/n 2,
     :item/prompt ["¿Cuándo necesita ir?" "Necesito ir mañana."],
     :item/answer ["When do you need to go?" "I need to go tomorrow."]}
    {:item/n 3,
     :item/prompt ["¿Cuándo quiere comer?" "Quiero comer ahora."],
     :item/answer ["When do you want to eat?" "I want to eat now."]}
    {:item/n 4,
     :item/prompt ["¿Quiere ver mi casa?" "Sí, me gustaría ver su casa."],
     :item/answer ["Do you want to see my house?" "Yes, I would like to see your house."]}
    {:item/n 5,
     :item/prompt ["¿Cuándo necesita regresar a su casa?" "Necesito regresar mañana en la noche."],
     :item/answer
     ["When do you need to go back to your house?" "I need to go back tomorrow night."]}
    {:item/n 6,
     :item/prompt
     ["¿Quiere comer en mi casa, o quiere comer en un restaurante?"
      "Me gustaría mucho comer en su casa."],
     :item/answer
     ["Do you want to eat in my house or do you want to eat in a restaurant?"
      "I would like (very) much to eat in your house."]}
    {:item/n 7,
     :item/prompt ["¿Quiere ir a Tijuana esta noche?" "No, no me gusta ir a Tijuana en la noche."],
     :item/answer
     ["Do you want to go to Tijuana tonight?" "No, I don't like to go to Tijuana in the night."],
     :item/alternatives
     [["Do you want to go to Tijuana tonight?"
       "No, I do not like to go to Tijuana in the night."]]}
    {:item/n 8,
     :item/prompt ["¿Quiere más?" "No, no quiero más, gracias."],
     :item/answer ["Do you want more?" "No, I don’t want (any) more,thank you."],
     :item/alternatives [["Do you want more?" "No, I do not want (any) more,thank you."]]}
    {:item/n 9,
     :item/prompt ["Necesita ayudar a su papá mañana." "No puedo, tengo que ir al doctor."],
     :item/answer ["You need to help your dad tomorrow." "I can’t, I have to go to the doctor."],
     :item/alternatives
     [["You need to help your dad tomorrow." "I cannot, I have to go to the doctor."]]}
    {:item/n 10,
     :item/prompt ["¿Quiere visitar México otra vez?" "Sí, quiero regresar el próximo año"],
     :item/answer ["Do you want to visit Mexico again?" "Yes, I want to go back next year."]}
    {:item/n 11,
     :item/prompt
     ["¿Quiere ir a una fiesta en mi casa el próximo fin de semana?"
      "Sí, me gustaría ir pero no puedo."],
     :item/answer
     ["Do you want to go to a party in my house next weekend?"
      "Yes, I would like to go but I can’t."],
     :item/alternatives
     [["Do you want to go to a party in my house next weekend?"
       "Yes, I would like to go but I cannot."]]}
    {:item/n 12,
     :item/prompt ["¿Necesita ir a México?" "Sí, tengo que ir mañana."],
     :item/answer ["Do you need to go to Mexico?" "Yes, I have to go tomorrow."]}
    {:item/n 13,
     :item/prompt ["¿Quiere ir a un restaurante conmigo?" "Sí, me gustaría ir con usted."],
     :item/answer
     ["Do you want to go to a restaurant with me?" "Yes, I would like to go with you."]}
    {:item/n 14,
     :item/prompt
     ["¿Quiere comer conmigo en el restaurante esta noche?"
      "Sí, me gustaría mucho comer con usted."],
     :item/answer
     ["Do you want to eat with me in the restaurant tonight?"
      "Yes, I would like (very) much to eat with you."]}
    {:item/n 15,
     :item/prompt ["Necesita ir conmigo para ver a mi mamá." "Sí, voy a ir con usted."],
     :item/answer
     ["You need to go with me (in order) to see my mom." "Yes, I am going to go with you."],
     :item/alternatives
     [["You need to go with me (in order) to see my mom." "Yes, I'm going to go with you."]]}
    {:item/n 16,
     :item/prompt ["¿Quiere regresar conmigo?" "Gracias, pero voy a regresar con Mario."],
     :item/answer
     ["Do you want to go back with me?" "Thank you, but I am going to go back with Mario."],
     :item/alternatives
     [["Do you want to go back with me?" "Thank you, but I'm going to go back with Mario."]]}
    {:item/n 17,
     :item/prompt ["Necesita trabajar conmigo hoy." "Sí, voy a trabajar con usted."],
     :item/answer ["You need to work with me today." "Yes, I am going to work with you."],
     :item/alternatives [["You need to work with me today." "Yes, I'm going to work with you."]]}
    {:item/n 18,
     :item/prompt
     ["¿Quiere pasar el fin de semana conmigo en México?"
      "Lo siento, pero no puedo, tengo que trabajar."],
     :item/answer
     ["Do you want to spend the weekend with me in Mexico?"
      "I am sorry, but I can’t, I have to work."],
     :item/alternatives
     [["Do you want to spend the weekend with me in Mexico?"
       "I'm sorry, but I cannot, I have to work."]]}],
