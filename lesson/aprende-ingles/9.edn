  {:exercise/id "9B",
   :exercise/skill :translate,
   :exercise/direction :to-base,
   :exercise/dialog? false,
   :exercise/instructions "Traduce estas frases al español.",
   :exercise/hints ["at home = en casa" "water = agua" "and = y"],
   :exercise/items
   [{:item/n 1,
     :item/prompt ["In order to see the moon you don't need a telescope."],
     :item/answer ["Para ver la luna no necesita un telescopio."]}
    {:item/n 2,
     :item/prompt ["You need to study a lot of Spanish in order to speak in your vacation."],
     :item/answer ["Necesita estudiar mucho español para hablar en sus vacaciones."]}
    {:item/n 3,
     :item/prompt ["Do you want to invite the teacher to the party?"],
     :item/answer ["¿Quiere invitar a la maestra a la fiesta?"]}
    {:item/n 4,
     :item/prompt ["When do you want to visit your family?"],
     :item/answer ["¿Cuándo quiere visitar a su familia?"]}
    {:item/n 5,
     :item/prompt ["Do you want to rent or buy a house?"],
     :item/answer ["¿Quiere rentar o comprar una casa?"]}
    {:item/n 6,
     :item/prompt
     ["Do you want to go back (return) to the restaurant again to eat more of the delicious tacos?"],
     :item/answer
     ["¿Quiere regresar al restaurante otra vez para comer más de los tacos deliciosos?"]}
    {:item/n 7,
     :item/prompt ["You need to return the video to Blockbuster."],
     :item/answer ["Necesita regresar el video a Blockbuster."]}
    {:item/n 8,
     :item/prompt ["You need to be at home with your family tonight."],
     :item/answer ["Necesita estar en casa con su familia esta noche."]}
    {:item/n 9,
     :item/prompt ["You need to spend more time with me and with your family."],
     :item/answer ["Necesita pasar más tiempo conmigo y con su familia."]}
    {:item/n 10,
     :item/prompt ["Do you want to rent a house in Puerto Vallarta this year?"],
     :item/answer ["¿Quiere rentar una casa en Puerto Vallarta este año?"]}
    {:item/n 11,
     :item/prompt ["Do you want to work in Mexico this year?"],
     :item/answer ["¿Quiere trabajar en México este año?"]}
    {:item/n 12,
     :item/prompt ["Do you want to go back (return) to the restaurant tomorrow night?"],
     :item/answer ["¿Quiere regresar al restaurante mañana en la noche?"]}
    {:item/n 13,
     :item/prompt ["You need to spend the night in a hotel."],
     :item/answer ["Necesita pasar la noche en un hotel."]}
    {:item/n 14,
     :item/prompt ["You need to drink a lot of water in the desert."],
     :item/answer ["Necesita tomar mucha agua en el desierto."]}
    {:item/n 15,
     :item/prompt ["When do you want to go back (return) to Mexico?"],
     :item/answer ["¿Cuándo quiere regresar a México?"]}
    {:item/n 16,
     :item/prompt ["Do you want to go to my house for a while in order to see my family?"],
     :item/answer ["¿Quiere ir a mi casa por un rato para ver a mi familia?"]}
    {:item/n 17,
     :item/prompt ["You need to continue tomorrow."],
     :item/answer ["Necesita continuar mañana."]}
    {:item/n 18,
     :item/prompt ["Do you want to work tonight or tomorrow?"],
     :item/answer ["¿Quiere trabajar esta noche o mañana?"]}
    {:item/n 19,
     :item/prompt ["Sir, you need to go to the doctor soon."],
     :item/answer ["Señor, necesita ir al doctor pronto."]}
    {:item/n 20,
     :item/prompt ["You need to speak more Spanish."],
     :item/answer ["Necesita hablar más español."]}],
   :exercise/notes []}
  {:exercise/id "9C",
   :exercise/skill :translate,
   :exercise/direction :to-base,
   :exercise/dialog? true,
   :exercise/instructions "Traduce cada intervención del diálogo al español.",
   :exercise/hints ["only = sólo"],
   :exercise/items
   [{:item/n 1,
     :item/prompt
     ["Do you need to travel this week?" "No, I am going to be home until next week."],
     :item/answer
     ["¿Necesita viajar esta semana?" "No, voy a estar en casa hasta la próxima semana."]}
    {:item/n 2,
     :item/prompt
     ["Do you want to work with me on the project?" "Yes, I can work with you next week."],
     :item/answer
     ["¿Quiere trabajar conmigo en el proyecto?"
      "Sí, puedo trabajar con usted la próxima semana."]}
    {:item/n 3,
     :item/prompt
     ["Do you want to drink a tequila with me?" "Thank you, but I don't much like tequila."],
     :item/answer
     ["¿Quiere tomar un tequila conmigo?" "Gracias, pero no me gusta mucho el tequila."]}
    {:item/n 4,
     :item/prompt
     ["Do you want to speak Spanish with me?"
      "Yes, I would like (very) much the opportunity (in order) to practice Spanish with you."],
     :item/answer
     ["¿Quiere hablar español conmigo?"
      "Sí, me gustaría mucho la oportunidad para practicar español con usted."]}
    {:item/n 5,
     :item/prompt
     ["Do you need to speak Spanish in the company?"
      "Yes, I need to speak Spanish every day with my clients."],
     :item/answer
     ["¿Necesita hablar español en la compañía?"
      "Sí, necesito hablar español cada día con mis clientes."]}
    {:item/n 6,
     :item/prompt
     ["Do you want to eat in a traditional restaurant?"
      "Frankly no, tonight I would prefer to eat American food."],
     :item/answer
     ["¿Quiere comer en un restaurante tradicional?"
      "Francamente no, esta noche preferiría comer comida americana."]}
    {:item/n 7,
     :item/prompt ["Do you want to eat in the restaurant tonight?" "Yes, can I invite a friend?"],
     :item/answer ["¿Quiere comer en el restaurante esta noche?" "Sí, ¿puedo invitar a un amigo?"]}
    {:item/n 8,
     :item/prompt
     ["Do you want to go to Spain in May with me?" "I want to go, but I can’t, I have to work."],
     :item/answer
     ["¿Quiere ir a España en mayo conmigo?" "Quiero ir, pero no puedo, tengo que trabajar."]}
    {:item/n 9,
     :item/prompt
     ["When do you need to go to the hotel?"
      "I need to go soon in order to confirm the reservation."],
     :item/answer
     ["¿Cuándo necesita ir al hotel?" "Necesito ir pronto para confirmar la reservación."]}
    {:item/n 10,
     :item/prompt
     ["Do you want to eat a burrito in the market?"
      "I want to eat in the market, but I prefer enchiladas (than) to burritos."],
     :item/answer
     ["¿Quiere comer un burrito en el mercado?"
      "Quiero comer en el mercado pero prefiero enchiladas que burritos."]}
    {:item/n 11,
     :item/prompt ["Do you want to see the menu?" "No, I only want a coffee please."],
     :item/answer ["¿Quiere ver el menú?" "No, sólo quiero un café por favor."]}
    {:item/n 12,
     :item/prompt ["Do you want to go to a party with me?" "Yes, when is the party?"],
     :item/answer ["¿Quiere ir a una fiesta conmigo?" "Sí, ¿cuándo es la fiesta?"]}
    {:item/n 13,
     :item/prompt
     ["Do you need to speak Spanish?"
      "Yes, I need to speak Spanish, it is very important for me."],
     :item/answer
     ["¿Necesita hablar español?" "Sí, necesito hablar español, es muy importante para mí."]}
    {:item/n 14,
     :item/prompt ["Do you want to eat something different?" "It depends."],
     :item/answer ["¿Quiere comer algo diferente?" "Depende!"]}
    {:item/n 15,
     :item/prompt
     ["Do you want to see the mariachis in Plaza Garibaldi tonight?"
      "Yes, I want to but I have to be (in) at the airport at 8:00 p.m."],
     :item/answer
     ["¿Quiere ver los Mariachis en Plaza Garibaldi esta noche?"
      "Sí, quiero pero tengo que estar en el aeropuerto a las 8:00 p.m."]}
    {:item/n 16,
     :item/prompt
     ["Do you need to see the passports?" "Yes, I need to see the passports and the visas."],
     :item/answer
     ["¿Necesita ver los pasaportes?" "Sí, necesito ver los pasaportes y las visas."]}],
   :exercise/notes []}
