  {:exercise/id "25D",
   :exercise/skill :translate,
   :exercise/direction :to-target,
   :exercise/dialog? true,
   :exercise/instructions "Traduce cada intervención del diálogo al inglés.",
   :exercise/hints [],
   :exercise/items
   [{:item/n 1,
     :item/prompt ["Tal vez vamos a poder hablar más español con ustedes pronto."],
     :item/answer ["Maybe we are going to be able to speak more Spanish with you all soon."],
     :item/alternatives
     [["Maybe we're going to be able to speak more Spanish with you all soon."]]}
    {:item/n 2,
     :item/prompt ["Vamos a estar con ustedes en México el próximo fin de semana."],
     :item/answer ["We are going to be with you all in Mexico next weekend."],
     :item/alternatives [["we're going to be with you all in Mexico next weekend."]]}
    {:item/n 3,
     :item/prompt ["Lo siento, no puedo estar con ustedes hoy."],
     :item/answer ["I am sorry, I can’t be with you all today."],
     :item/alternatives [["I'm sorry, I cannot be with you all today."]]}
    {:item/n 4,
     :item/prompt ["Tal vez ella va a regresar con Mario." "Sí, va a regresar con él."],
     :item/answer
     ["Maybe (she) is going to go back with Mario." "Yes, she is going to go back with him."]}
    {:item/n 5,
     :item/prompt ["¿A ellos les gusta México?" "Si, les encanta México."],
     :item/answer ["Do (they) like Mexico?" "Yes, they love Mexico."]}
    {:item/n 6,
     :item/prompt ["Vamos a desayunar con ellas mañana."],
     :item/answer ["We are going to have breakfast with them (women) tomorrow."],
     :item/alternatives [["we're going to have breakfast with them (women) tomorrow."]]}
    {:item/n 7,
     :item/prompt ["Ustedes necesitan hablar con ellos cuanto antes."],
     :item/answer ["(You all) need to speak with them as soon as possible."]}
    {:item/n 8,
     :item/prompt ["Voy a cenar con ella mañana en la noche."],
     :item/answer ["I am going to have dinner with her tomorrow night."],
     :item/alternatives [["I'm going to have dinner with her tomorrow night."]]}
    {:item/n 9,
     :item/prompt ["Tengo que estudiar casi todos los días."],
     :item/answer ["I have to study almost (all the days) everyday."]}
    {:item/n 10,
     :item/prompt ["Ellos tienen que trabajar casi todos los fines de semana."],
     :item/answer ["(They) have to work almost all the weekends."]}
    {:item/n 11,
     :item/prompt ["Nadie tiene que trabajar este fin de semana."],
     :item/answer ["Nobody has to work this weekend."]}
    {:item/n 12,
     :item/prompt
     ["Tal vez a ellos no les gusta vivir aquí." "No, a ellos les encanta vivir aquí."],
     :item/answer
     ["Maybe (they) don't like (to live) living here." "No, they love (to live) living here."],
     :item/alternatives
     [["Maybe (they) do not like (to live) living here." "No, they love (to live) living here."]]}
    {:item/n 13,
     :item/prompt ["A ellas les gusta cantar."],
     :item/answer ["(They females) like to sing."]}
    {:item/n 14,
     :item/prompt ["Ustedes van a poder hablar español pronto."],
     :item/answer ["(You all) are going to be able to speak Spanish soon."]}
    {:item/n 15,
     :item/prompt ["¿Por qué a ellos no les gusta viajar?"],
     :item/answer ["Why don't (they) like to travel?"],
     :item/alternatives [["Why do not (they) like to travel?"]]}
    {:item/n 16,
     :item/prompt ["¿A ellas les gustaría ir a un restaurante mexicano?"],
     :item/answer ["Would (they females) like to go to a Mexican restaurant?"]}
    {:item/n 17,
     :item/prompt ["Podemos caminar con ella al hotel."],
     :item/answer ["We can walk with her to the hotel."]}
    {:item/n 18,
     :item/prompt ["¿A ellos les gusta leer?" "No, no les gusta leer mucho."],
     :item/answer ["Do (they) like to read?" "No, they don’t like to read much."],
     :item/alternatives [["Do (they) like to read?" "No, they do not like to read much."]]}
    {:item/n 19,
     :item/prompt ["Ustedes van a comprender más después de estudiar en México."],
     :item/answer ["(You all) are going to understand more after (to study) studying in Mexico."]}
    {:item/n 20,
     :item/prompt ["¿Cuándo ustedes quieren viajar?" "Queremos ir pasado mañana en la tarde."],
     :item/answer
     ["When do (you all) want to travel?"
      "We want to go the day after tomorrow in the afternoon."]}
    {:item/n 21,
     :item/prompt ["¿Ustedes pueden escucharme?" "Sí, podemos escucharlo."],
     :item/answer ["Can (you all) hear (listen) me?" "Yes, we can hear you (man)."]}
    {:item/n 22,
     :item/prompt ["Puedo practicar casi todos los días."],
     :item/answer ["I can practice almost every day (all the days)."]}
    {:item/n 23,
     :item/prompt
     ["¿Ustedes quieren encontrar un hotel?" "Sí, queremos encontrar un hotel ahora."],
     :item/answer ["Do (you all) want to find a hotel?" "Yes, we want to find a hotel now."]}],
