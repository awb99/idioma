  {:exercise/id "25B",
   :exercise/skill :translate,
   :exercise/direction :to-base,
   :exercise/dialog? true,
   :exercise/instructions "Traduce cada intervención del diálogo al español.",
   :exercise/hints [],
   :exercise/items
   [{:item/n 1,
     :item/prompt ["Maybe you all can practice Spanish with them."],
     :item/answer ["Tal vez ustedes pueden practicar el español con ellos."]}
    {:item/n 2,
     :item/prompt
     ["They need to learn more Spanish in order to speak with us."
      "Yes, they are going to study in private classes."],
     :item/answer
     ["Ellos necesitan aprender más español para hablar con nosotros."
      "Si, van a estudiar en clases privadas."]}
    {:item/n 3,
     :item/prompt ["They (women) need a taxi." "I am going to call a taxi for them right now."],
     :item/answer ["Ellas necesitan un taxi." "Voy a llamar un taxi para ellas ahora mismo."]}
    {:item/n 4,
     :item/prompt ["Many Mexicans like to eat tacos after to go out (to dance) dancing."],
     :item/answer ["A muchos mexicanos les gusta comer tacos después de salir a bailar."]}
    {:item/n 5,
     :item/prompt
     ["The students don't want to invite their teacher to the party."
      "Why don't they want to invite him?"
      "Because they don't like the teacher."],
     :item/answer
     ["Los estudiantes no quieren invitar a su maestro a la fiesta."
      "¿Por qué no quieren invitarlo?"
      "Porque no les gusta el maestro."]}
    {:item/n 6,
     :item/prompt
     ["They (women) want to go to a typical restaurant, they would like to try the traditional food (of) here."],
     :item/answer
     ["Ellas quieren ir a un restaurante típico, les gustaría probar la comida tradicional de aquí."]}
    {:item/n 7,
     :item/prompt ["He is going to spend almost all his money."],
     :item/answer ["Él va a gastar casi todo su dinero."]}
    {:item/n 8,
     :item/prompt ["Nobody wants to go with me."],
     :item/answer ["Nadie quiere ir conmigo."]}
    {:item/n 9,
     :item/prompt ["Do they like the food?" "Yes, they love the food."],
     :item/answer ["¿A ellos les gusta la comida?" "Sí, ellos les encanta la comida."]}
    {:item/n 10,
     :item/prompt ["Who can help Lisa?" "No body can help her today."],
     :item/answer ["¿Quién puede ayudar a Lisa?" "Nadie puede ayudarla hoy."]}
    {:item/n 11,
     :item/prompt ["She can speak all the night without (to breath) breathing."],
     :item/answer ["Ella puede hablar toda la noche sin respirar."]}
    {:item/n 12,
     :item/prompt ["I want to try almost all the food on the menu."],
     :item/answer ["Quiero probar casi toda la comida en el menú."]}
    {:item/n 13,
     :item/prompt ["The company is going to pay almost all the costs."],
     :item/answer ["La compañía va a pagar casi todos los costos."]}
    {:item/n 14,
     :item/prompt ["He is going to speak for an hour."],
     :item/answer ["Él va a hablar por una hora."]}
    {:item/n 15,
     :item/prompt ["They would like to speak with you all."],
     :item/answer ["A ellos les gustaría hablar con ustedes."]}
    {:item/n 16,
     :item/prompt ["I would like to be able to speak more Spanish with you all."],
     :item/answer ["Me gustaría poder hablar más español con ustedes."]}
    {:item/n 17,
     :item/prompt ["I am sorry, I don't want to work (any) more with you all."],
     :item/answer ["Lo siento, no quiero trabajar más con ustedes."]}
    {:item/n 18,
     :item/prompt ["You all have to learn more Spanish in order to be able to speak with him."],
     :item/answer ["Tienen que aprender más español para poder hablar con él."]}
    {:item/n 19,
     :item/prompt
     ["Maybe you all can study with Miguel."
      "Yes, we are going to study with him (all the afternoons) every afternoon in the cafeteria."],
     :item/answer
     ["Tal vez ustedes pueden estudiar con Miguel."
      "Sí, vamos a estudiar con él todas las tardes en la cafetería."]}
    {:item/n 20,
     :item/prompt
     ["You need to speak more with him in order to practice Spanish."
      "Yes, I am going to speak with him (all the days) every day."],
     :item/answer
     ["Necesita hablar más con él para practicar español."
      "Sí, voy a hablar con él todos los días."]}
    {:item/n 21,
     :item/prompt ["I like to practice Spanish with her."],
     :item/answer ["Me gusta practicar español con ella."]}
    {:item/n 22,
     :item/prompt ["He is going to work there with her."],
     :item/answer ["Él va a trabajar allá con ella."]}
    {:item/n 23,
     :item/prompt ["Maybe they are going to speak with her later."],
     :item/answer ["Tal vez ellos van a hablar con ella más tarde."]}
    {:item/n 24, :item/prompt ["Nobody can help me."], :item/answer ["Nadie puede ayudarme."]}],
   :exercise/notes []}
