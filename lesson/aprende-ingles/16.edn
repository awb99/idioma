 :lesson/title "Más verbos, más frases",
 :lesson/target-title "More verbs, more sentences",
 :lesson/label "Lección 16",
 :lesson/sections
 [{:section/type :communication-multiplied,
   :section/id 13,
   :section/title "Love: personas y cosas",
   :section/body
   ["love se usa con personas: I love my mother."
    "Con cosas es más natural like o love según el contexto: I love beer = me encanta la cerveza."
    "La estructura I love + sustantivo es muy común en inglés."
    "I would love to visit Mexico = me encantaría visitar México."]}
  {:section/type :communication-multiplied,
   :section/id 14,
   :section/title "After + verbo",
   :section/body
   ["after funciona como before: after having dinner, after I dine."
    "Con el mismo sujeto puedes usar after + -ing: after studying, we like to play football."
    "En inglés, after y before no llevan to delante del verbo."
    "After dinner I like to walk = después de cenar, me gusta caminar."]}
  {:section/type :accuracy-pointer,
   :section/id 13,
   :section/title "Where o to where",
   :section/body
   ["En inglés se dice Where do you want to go? No hace falta to al final."
    "Where va al principio de la pregunta."
    "Con lugares puedes usar where; con personas usas who."]}
  {:section/type :accuracy-pointer,
   :section/id 14,
   :section/title "Tomorrow morning",
   :section/body
   ["tomorrow morning = mañana por la mañana."
    "No digas *tomorrow in the morning*; en inglés se omite la preposición."
    "tonight = esta noche; tomorrow night = mañana por la noche."]}],
 :lesson/number 16,
 :lesson/intro [],
 :lesson/step {:step/number 3, :step/title "Hablemos de nosotros"},
 :lesson/closing
 ["Enhorabuena, casi has terminado el paso 3."
  "Ya tienes una base muy amplia para hablar de nosotros y de nuestro entorno."
  "Solo faltan unos cuantos verbos y una estructura sencilla para sonar más natural."],
