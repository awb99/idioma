  {:exercise/id "20B",
   :exercise/skill :translate,
   :exercise/direction :to-base,
   :exercise/dialog? false,
   :exercise/instructions "Traduce estas frases al español.",
   :exercise/hints
   ["bullfight = corrida de toros" "newspaper = periódico" "first = primera" "word = palabra"],
   :exercise/items
   [{:item/n 1,
     :item/prompt ["You all have to practice Spanish."],
     :item/answer ["Tienen que practicar español."]}
    {:item/n 2,
     :item/prompt ["Do you like to read the newspaper?"],
     :item/answer ["¿Le gusta leer el periódico?"]}
    {:item/n 3,
     :item/prompt ["If you all want, we are going to leave early in order to avoid the traffic."],
     :item/answer ["Si quieren, vamos a salir temprano para evitar el tráfico."]}
    {:item/n 4,
     :item/prompt ["I am going to practice a lot of Spanish with my Mexican friends."],
     :item/answer ["Voy a practicar mucho español con mis amigos mexicanos."]}
    {:item/n 5,
     :item/prompt ["Would you all like to read the menu?"],
     :item/answer ["¿Les gustaría leer el menú?"]}
    {:item/n 6,
     :item/prompt
     ["When are you all going to come back? We are going to come back next year in order to live here."],
     :item/answer ["¿Cuándo van a regresar? Vamos a regresar el próximo año para vivir aquí."]}
    {:item/n 7,
     :item/prompt ["What type of food do you all like?"],
     :item/answer ["¿Qué tipo de comida les gusta?"]}
    {:item/n 8,
     :item/prompt ["You have to read the instructions."],
     :item/answer ["Tiene que leer las instrucciones."]}
    {:item/n 9,
     :item/prompt ["We want to order now. What would you all like to order?"],
     :item/answer ["Queremos ordenar ahora. ¿Qué les gustaría ordenar?"]}
    {:item/n 10,
     :item/prompt ["You all need to read a lot more in order to advance your Spanish."],
     :item/answer ["Necesitan leer mucho más para avanzar su español."]}
    {:item/n 11,
     :item/prompt ["I can’t live (with) on this salary."],
     :item/answer ["No puedo vivir con este salario."]}
    {:item/n 12,
     :item/prompt
     ["Would you all like to drink a coffee here before (to return) going back to the hotel?"],
     :item/answer ["¿Les gustaría tomar un café aquí antes de regresar al hotel?"]}
    {:item/n 13,
     :item/prompt ["Why don't you all like to travel to Mexico?"],
     :item/answer ["¿Por qué no les gusta viajar a México?"]}
    {:item/n 14,
     :item/prompt ["Do you all like Mexican food? We love Mexican food."],
     :item/answer ["¿Les gusta la comida mexicana? Nos encanta la comida mexicana."]}
    {:item/n 15,
     :item/prompt ["Would you all like to drink a coffee here?"],
     :item/answer ["¿Les gustaría tomar un café aquí?"]}
    {:item/n 16,
     :item/prompt ["What would you all like to do today? We would like to see a bullfight."],
     :item/answer ["¿Qué les gustaría hacer hoy? Nos gustaría ver una corrida de toros."]}
    {:item/n 17,
     :item/prompt ["Do you like the Spanish class? Yes, we like (it) a lot."],
     :item/answer ["¿Les gusta la clase de español? Si, nos gusta mucho."]}
    {:item/n 18,
     :item/prompt ["Would you all like to go to Xochimilco?"],
     :item/answer ["¿Les gustaría ir a Xochimilco?"]}
    {:item/n 19,
     :item/prompt ["I need to practice (much) my Spanish a lot."],
     :item/answer ["Necesito practicar mucho mi español."]}
    {:item/n 20,
     :item/prompt
     ["(The) on Sunday would you all like to go with me in order to see a bullfight?"],
     :item/answer ["¿El domingo les gustaría ir conmigo para ver una corrida de toros?"]}
    {:item/n 21,
     :item/prompt ["Can you read the first line?"],
     :item/answer ["¿Puede leer la primera línea?"]}
    {:item/n 22,
     :item/prompt ["Would you all like to spend a weekend (in) at my beach house in Acapulco?"],
     :item/answer ["¿Les gustaría pasar un fin de semana en mi casa de playa en Acapulco?"]}
    {:item/n 23,
     :item/prompt
     ["In what part of Mexico would you like to live? I would like to live in Puerto Vallarta."],
     :item/answer
     ["¿En qué parte de México le gustaría vivir? Me gustaría vivir en Puerto Vallarta."]}
    {:item/n 24,
     :item/prompt
     ["I like to read a lot in Spanish, because there are many similar words to English."],
     :item/answer
     ["Me gusta leer mucho en español porque hay muchas palabras similares al inglés."]}
    {:item/n 25,
     :item/prompt ["Before (to order) ordering, do you all want to drink a tequila?"],
     :item/answer ["¿Antes de ordenar, quieren tomar un tequila?"]}],
   :exercise/notes []}
