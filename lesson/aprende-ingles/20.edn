 :lesson/title "Acuerdos y gustos",
 :lesson/target-title "Likes and agreement",
 :lesson/label "Lección 20",
 :lesson/sections
 [{:section/type :accuracy-pointer,
   :section/id 17,
   :section/title "Would you all like...?",
   :section/body
   ["Would like sirve para todas las personas: I would like, you would like, they would like."
    "La forma no cambia; solo cambia el sujeto."
    "Would you all like a coffee? = ¿Les gustaría un café?"
    "No digas *would likes*."]}],
 :lesson/number 20,
 :lesson/intro [],
 :lesson/step {:step/number 4, :step/title "Ellos también hablan, ¿no?"},
 :lesson/closing
 ["Enhorabuena, casi has terminado el paso 4."
  "Ya no quedan verbos nuevos de este tipo."
  "En el paso 5 aprenderás las últimas palabras y estructuras."
  "Sigue así, vas muy bien."],
