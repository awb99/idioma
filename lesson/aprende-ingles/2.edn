 :lesson/sections
 [{:section/type :accuracy-pointer,
   :section/id 1,
   :section/title "Sonidos nuevos del inglés",
   :section/body
   ["La h del inglés se pronuncia con un soplo suave: have suena como «jav»."
    "La v se parece a la b: very suena como «veri»."
    "La th no existe en español: the suena como «de» y with como «uid»."
    "No te preocupes por la perfección; imita el sonido y sigue adelante."]}
  {:section/type :communication-multiplied,
   :section/id 2,
   :section/title "I want to see him / her",
   :section/body
   ["En inglés el pronombre de objeto va después del verbo: I want to see him."
    "him = lo, her = la, me = me, us = nos, them = los/las."
    "La estructura es: sujeto + verbo + to + verbo + pronombre."
    "I want to see him = quiero verlo; I want to see her = quiero verla."
    "A diferencia del español, el pronombre no se pega al verbo."]}],
 :lesson/number 2,
 :lesson/intro [],
 :lesson/step {:step/number 1, :step/title "Primeros pasos para hablar inglés"},
