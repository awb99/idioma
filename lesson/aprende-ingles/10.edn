 :lesson/sections
 [{:section/type :accuracy-pointer,
   :section/id 8,
   :section/title "I would like",
   :section/body
   ["I would like es una forma educada de decir I want."
    "La estructura es: I would like + to + verbo: I would like to learn English."
    "Con he y she la forma no cambia: he would like, she would like."
    "Would like nunca lleva -s en la tercera persona."]}
  {:section/type :communication-multiplied,
   :section/id 9,
   :section/title "You want to see me",
   :section/body
   ["El pronombre de objeto puede ir después del verbo: You want to see me."
    "me = me; you = te/lo/la; us = nos; them = los/las."
    "La estructura es: sujeto + want + to + verbo + pronombre."
    "You want to see me = quieres verme."]}],
