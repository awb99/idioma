{:lesson/vocabulary [],
 :lesson/title "Pronombres y ambigüedad",
 :lesson/target-title "Pronouns and ambiguity",
 :lesson/label "Lección 24",
 :lesson/sections
 [{:section/type :communication-multiplied,
   :section/id 21,
   :section/title "They have to go",
   :section/body
   ["they se usa para varias personas o cosas: they have to go."
    "En inglés el verbo con they es el mismo que con we y you: they want, we want."
    "Para distinguir you all de they, usa el contexto o añade all/they."
    "They can go = pueden ir; they are going to go = van a ir."]}],
 :lesson/number 24,
 :lesson/intro
 ["No hay palabras nuevas en esta lección, solo una estructura para completar tu inglés."],
 :lesson/step {:step/number 5, :step/title "Hablar de otras personas"},
 :lesson/closing [],
 :lesson/exercises
 [{:exercise/id "24A",
   :exercise/skill :translate,
   :exercise/direction :to-base,
   :exercise/dialog? true,
   :exercise/instructions "Traduce cada intervención del diálogo al español.",
   :exercise/hints [],
   :exercise/items
   [{:item/n 1,
     :item/prompt ["They can’t hear you." "Okay, I am going to speak more loudly."],
     :item/answer ["Ellos no pueden escucharlo." "Okay, voy a hablar más fuerte."]}
    {:item/n 2,
     :item/prompt ["The students need to listen to the CDs (all the days) everyday."],
     :item/answer ["Los estudiantes necesitan escuchar las CDs todos los días."]}
    {:item/n 3,
     :item/prompt ["With this method the students can’t forget the verbs."],
     :item/answer ["Con este método los estudiantes no pueden olvidar los verbos."]}
    {:item/n 4,
     :item/prompt
     ["They (women) need to rent a car." "What type of car do they want?" "They want a big car."],
     :item/answer
     ["Ellas necesitan rentar un coche." "¿Qué tipo de coche quieren?" "Quieren un coche grande."]}
    {:item/n 5,
     :item/prompt
     ["What documentation are they (women) going to need in order to travel to Mexico?"
      "They need visas and passports."],
     :item/answer
     ["¿Qué documentación ellas van a necesitar para viajar a México?"
      "Necesitan visas y pasaportes."]}
    {:item/n 6,
     :item/prompt
     ["Where do you all want to rent this summer?"
      "We want to rent a house in the Mayan Riviera."],
     :item/answer
     ["¿Dónde quieren ustedes rentar este verano?" "Queremos rentar una casa en la Riviera Maya."]}
    {:item/n 7,
     :item/prompt
     ["They want to work in Mexico in summer."
      "They want to work as (teachers of English) English teachers."],
     :item/answer
     ["Ellos quieren trabajar en México en el verano."
      "Quieren trabajar como maestros de inglés."]}
    {:item/n 8,
     :item/prompt ["My friends want to go to Mexico this winter."],
     :item/answer ["Mis amigos quieren ir a México este invierno."]}
    {:item/n 9,
     :item/prompt ["They are going to pay with a credit card."],
     :item/answer ["Ellos van a pagar con una tarjeta de crédito."]}
    {:item/n 10,
     :item/prompt ["Why do they want to learn Spanish?" "In order to speak on their vacation."],
     :item/answer ["¿Por qué ellos quieren aprender español?" "Para hablar en sus vacaciones."]}
    {:item/n 11,
     :item/prompt ["They can understand more Spanish now."],
     :item/answer ["Ellos pueden comprender más español ahora."]}
    {:item/n 12,
     :item/prompt ["They (women) need to call the police."],
     :item/answer ["Ellas necesitan llamar a la policía."]}
    {:item/n 13,
     :item/prompt ["You all are going to speak a lot of Spanish in your vacation."],
     :item/answer ["Ustedes van a hablar mucho español en sus vacaciones."]}
    {:item/n 14,
     :item/prompt ["When are they going to arrive?" "They are going to arrive on Sunday."],
     :item/answer ["¿Cuándo ellos van a llegar?" "Van a llegar el domingo."]}
    {:item/n 15,
     :item/prompt ["If they are going to rent a car there, they have to buy an (some) insurance."],
     :item/answer ["Si ellos van a rentar un coche allá tienen que comprar un seguro."]}
    {:item/n 16,
     :item/prompt ["They can listen to (cassettes of Spanish) Spanish cassettes in their cars."],
     :item/answer ["Ellos pueden escuchar casetes de español en sus coches."]}
    {:item/n 17,
     :item/prompt
     ["Where are they going to study?" "They are going to study in a college in Costa Rica."],
     :item/answer ["¿Dónde ellos van a estudiar?" "Van a estudiar en un colegio en Costa Rica."]}
    {:item/n 18,
     :item/prompt ["You all are not going to spend much money in Oaxaca."],
     :item/answer ["Ustedes no van a gastar mucho dinero en Oaxaca."]}
    {:item/n 19,
     :item/prompt ["Do you all want to find a house to rent?"],
     :item/answer ["¿Ustedes quieren encontrar una casa para rentar?"]}
    {:item/n 20,
     :item/prompt
     ["When are they going to start (they) the Spanish class?" "They are going to start in July."],
     :item/answer ["¿Cuándo ellos van a empezar la clase de español?" "Van a empezar en julio."]}
    {:item/n 21,
     :item/prompt ["They need to read a lot more in order to advance in their Spanish."],
     :item/answer ["Ellos necesitan leer mucho más para avanzar en su español."]}
    {:item/n 22,
     :item/prompt ["They (women) are going to cook all the food for the party."],
     :item/answer ["Ellas van a cocinar toda la comida para la fiesta."]}],
   :exercise/notes []}
  {:exercise/id "24B",
   :exercise/skill :translate,
   :exercise/direction :to-target,
   :exercise/dialog? true,
   :exercise/instructions "Traduce cada intervención del diálogo al inglés.",
   :exercise/hints [],
   :exercise/items
   [{:item/n 1,
     :item/prompt ["Ustedes van a hablar español muy bien pronto."],
     :item/answer ["(You all) are going to speak Spanish very well soon."]}
    {:item/n 2,
     :item/prompt ["Ellas quieren encontrar un hotel."],
     :item/answer ["(They females) want to find a hotel."]}
    {:item/n 3,
     :item/prompt ["Lupita y Juan no van a poder visitarnos este invierno."],
     :item/answer ["Lupita and Juan are not going to be able to visit us this winter."],
     :item/alternatives [["Lupita and Juan aren't going to be able to visit us this winter."]]}
    {:item/n 4,
     :item/prompt ["Ellos quieren invitarnos a una fiesta."],
     :item/answer ["(They) want to invite us to a party."]}
    {:item/n 5,
     :item/prompt ["¿Ustedes pueden escucharme?" "No, no podemos escucharlo."],
     :item/answer ["Can (you all) hear me?" "No, we can’t hear you (man)."],
     :item/alternatives [["Can (you all) hear me?" "No, we cannot hear you (man)."]]}
    {:item/n 6,
     :item/prompt ["Ustedes van a vivir bien allá."],
     :item/answer ["(You all) are going to live well there."]}
    {:item/n 7,
     :item/prompt ["Ellas necesitan un taxi."],
     :item/answer ["(They females) need a taxi."]}
    {:item/n 8,
     :item/prompt ["Ustedes pueden practicar el español con nosotros."],
     :item/answer ["(You all) can practice Spanish with us."]}
    {:item/n 9,
     :item/prompt ["Ustedes necesitan aprender más español para poder hablar con nosotros."],
     :item/answer ["(You all) need to learn more Spanish in order to be able speak with us."]}
    {:item/n 10,
     :item/prompt ["Ellas pueden ir con nosotros si quieren."],
     :item/answer ["(They females) can go with us, if they want."]}
    {:item/n 11,
     :item/prompt ["Ellos quieren regresar pronto."],
     :item/answer ["(They) want to return soon."]}
    {:item/n 12,
     :item/prompt ["Ellos van a estudiar español en Guatemala en el verano."],
     :item/answer ["(They) are going to study Spanish in Guatemala in the summer."]}
    {:item/n 13,
     :item/prompt ["¿Cuándo ellos quieren empezar?" "Quieren empezar mañana."],
     :item/answer ["When do (they) want to start?" "They want to start tomorrow."]}
    {:item/n 14,
     :item/prompt ["¿Ellos van a ayudarnos?"],
     :item/answer ["Are (they) going to help us?"]}
    {:item/n 15,
     :item/prompt ["¿Cuándo ustedes van a llegar?" "Vamos a llegar pasado mañana."],
     :item/answer
     ["When are (you all) going to arrive?" "We are going to arrive the day after tomorrow."],
     :item/alternatives
     [["When are (you all) going to arrive?" "we're going to arrive the day after tomorrow."]]}
    {:item/n 16, :item/prompt ["Ellos pueden ayudarnos."], :item/answer ["(They) can help us."]}
    {:item/n 17,
     :item/prompt ["¿Ellos quieren descansar un rato?"],
     :item/answer ["Do (They) want to rest a while?"]}
    {:item/n 18,
     :item/prompt ["Ellos no van a poder empezar hasta el verano."],
     :item/answer ["They are not going to be able to start until the summer."],
     :item/alternatives [["They aren't going to be able to start until the summer."]]}
    {:item/n 19,
     :item/prompt ["Ellas no quieren ir con él, porque él no puede manejar muy bien."],
     :item/answer
     ["(They females) don't want to go with him, because (he) can’t drive very well."],
     :item/alternatives
     [["(They females) do not want to go with him, because (he) cannot drive very well."]]}
    {:item/n 20,
     :item/prompt ["Ellos quieren ver nuestra casa."],
     :item/answer ["(They) want to see our house."]}
    {:item/n 21,
     :item/prompt ["Ellas no pueden cantar muy bien."],
     :item/answer ["(They females) can’t sing very well."],
     :item/alternatives [["(They females) cannot sing very well."]]}
    {:item/n 22,
     :item/prompt ["Ellas no quieren ir a la fiesta."],
     :item/answer ["(They females) don't want to go to the party."],
     :item/alternatives [["(They females) do not want to go to the party."]]}
    {:item/n 23,
     :item/prompt ["Ellos van a estar en casa hoy."],
     :item/answer ["(They) are going to be (in house) home today."]}
    {:item/n 24,
     :item/prompt ["Ellos van a invitarme a la fiesta."],
     :item/answer ["(They) are going to invite me to the party."]}
    {:item/n 25,
     :item/prompt ["Ellas tienen que hablar español todos los días."],
     :item/answer ["(They females) have to speak Spanish (all the days) every day."]}
    {:item/n 26,
     :item/prompt ["Ellas van a llamarnos mañana."],
     :item/answer ["(They females) are going to call us tomorrow."]}
    {:item/n 27,
     :item/prompt ["Ustedes necesitan estudiar más."],
     :item/answer ["(You all) need to study more."]}
    {:item/n 28,
     :item/prompt ["No pueden leer."],
     :item/answer ["They can’t read."],
     :item/alternatives [["They cannot read."]]}],
   :exercise/notes []}]}
