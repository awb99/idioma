 :lesson/sections
 [{:section/type :accuracy-pointer,
   :section/id 15,
   :section/title "Know: personas y hechos",
   :section/body
   ["En inglés know sirve para personas y para hechos: I know Ana, I know the answer."
    "No hay dos verbos como conocer y saber; know cubre ambos."
    "Para conocer a alguien por primera vez usas meet."
    "I am going to meet my granddaughter = voy a conocer a mi nieta."]}
  {:section/type :communication-multiplied,
   :section/id 15,
   :section/title "We want to see them",
   :section/body
   ["them se usa para personas o cosas: We want to see them."
    "them = los/las; en inglés no distingue el género."
    "La estructura es: sujeto + want + to + verbo + them."
    "We want to see them = queremos verlos o verlas."]}],
 :lesson/number 17,
