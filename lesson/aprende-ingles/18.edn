  {:exercise/id "18D",
   :exercise/skill :translate,
   :exercise/direction :to-target,
   :exercise/dialog? false,
   :exercise/instructions "Traduce estas frases al inglés.",
   :exercise/hints ["to leave, but can also be used for to go out = Salir"],
   :exercise/items
   [{:item/n 1, :item/prompt ["Pueden ir con nosotros."], :item/answer ["You all can go with us."]}
    {:item/n 2,
     :item/prompt ["¿Quieren aprender español?"],
     :item/answer ["Do you all want to learn Spanish?"]}
    {:item/n 3,
     :item/prompt ["¿Quieren regresar a la casa por un rato?"],
     :item/answer ["Do you all want to go back to the house for a while?"]}
    {:item/n 4,
     :item/prompt ["Necesitan hablar con él cuanto antes."],
     :item/answer ["You all need to speak with him as soon as possible."]}
    {:item/n 5,
     :item/prompt ["Pueden pasar la noche en nuestra casa."],
     :item/answer ["You all can spend the night in our house."]}
    {:item/n 6,
     :item/prompt ["Queremos estudiar con ustedes."],
     :item/answer ["We want to study with you all."]}
    {:item/n 7,
     :item/prompt ["Necesitan esperarlos."],
     :item/answer ["You all need to wait for them."]}
    {:item/n 8,
     :item/prompt ["¿Quieren invitarlo?"],
     :item/answer ["Do you all want to invite him?"]}
    {:item/n 9,
     :item/prompt ["¿Por qué no pueden invitarme?"],
     :item/answer ["Why can’t you all invite me?"],
     :item/alternatives [["Why cannot you all invite me?"]]}
    {:item/n 10,
     :item/prompt ["¿Quieren regresar con nosotros?"],
     :item/answer ["Do you all want to go back with us?"]}
    {:item/n 11,
     :item/prompt ["Mañana necesitamos manejar hasta La Paz. Necesitan manejar mucho."],
     :item/answer
     ["Tomorrow we need to drive as far as (until) La Paz. You all need to drive a lot."]}
    {:item/n 12,
     :item/prompt ["¿Quieren descansar esta noche? No, nos gustaría salir."],
     :item/answer ["Do you all want to rest tonight? No, we would like to go out."]}
    {:item/n 13,
     :item/prompt ["¿Qué quieren hacer? Queremos descansar un rato."],
     :item/answer ["What do you all want to do? We want to rest a while."]}
    {:item/n 14,
     :item/prompt ["¿Cuándo necesitan ir? Necesitamos ir antes del verano."],
     :item/answer ["When do you all need to go? We need to go before the summer."]}
    {:item/n 15,
     :item/prompt ["¿Necesitan un taxi? No, nos gustaría caminar, gracias."],
     :item/answer ["Do you all need a taxi? No, we would like to walk,thanks."]}
    {:item/n 16,
     :item/prompt ["Necesitan visitarnos otra vez."],
     :item/answer ["You all need to visit us again."]}
    {:item/n 17,
     :item/prompt
     ["¿Dónde quieren pasar el verano? Queremos pasar el verano en España con nuestra familia."],
     :item/answer
     ["Where do you all want to spend the summer? We want to spend the summer in Spain with our family."]}
    {:item/n 18,
     :item/prompt ["¿Por qué quieren aprender español? Para hablar con ustedes."],
     :item/answer ["Why do you all want to learn Spanish? In order to speak with you all."]}
    {:item/n 19,
     :item/prompt ["¿Pueden regresar a México en verano? Sí, podemos regresar en verano."],
     :item/answer ["Can you all return to México in the summer? Yes, we can come back in summer."]}
    {:item/n 20,
     :item/prompt ["¿Quieren terminar pronto? Sí, cuanto antes."],
     :item/answer ["Do you all want to finish soon? Yes, as soon as possible."]}
    {:item/n 21,
     :item/prompt ["¿Dónde podemos esperarla? Pueden esperarla en la casa."],
     :item/answer ["Where can we wait for her? You all can wait for her in the house."]}
    {:item/n 22,
     :item/prompt ["¿Quieren estudiar con nosotros? Sí, nos gustaría estudiar con ustedes."],
     :item/answer ["Do you all want to study with us? Yes, we would like to study with you all."]}
    {:item/n 23,
     :item/prompt ["¿Quieren cenar con nosotros? Sí, nos encantaría cenar con ustedes."],
     :item/answer
     ["Do you all want to have dinner with us? Yes, we would love to have dinner with you all."]}
    {:item/n 24,
     :item/prompt ["¿Pueden hablar más español con nosotros?"],
     :item/answer ["Can you all speak more Spanish with us?"]}],
   :exercise/notes []}]}
