 :lesson/title "Ellos y ustedes",
 :lesson/target-title "They and you all",
 :lesson/label "Lección 18",
 :lesson/sections
 [{:section/type :communication-multiplied,
   :section/id 16,
   :section/title "You all / you plural",
   :section/body
   ["En inglés you sirve para una persona y para varias."
    "Para evitar dudas se usa you all, you guys o you everyone."
    "El verbo no cambia: you want = you all want."
    "En inglés no existe una forma verbal distinta para el plural de you."]}],
 :lesson/number 18,
 :lesson/intro [],
 :lesson/step {:step/number 4, :step/title "Ellos también hablan, ¿no?"},
 :lesson/closing [],
