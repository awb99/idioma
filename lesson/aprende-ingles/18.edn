  {:exercise/id "18B",
   :exercise/skill :translate,
   :exercise/direction :to-base,
   :exercise/dialog? false,
   :exercise/instructions "Traduce estas frases al español.",
   :exercise/hints ["beach = playa" "teachers = maestros"],
   :exercise/items
   [{:item/n 1, :item/prompt ["Can you all hear him?*"], :item/answer ["¿Pueden escucharlo?"]}
    {:item/n 2,
     :item/prompt ["With this method you all can’t forget the verbs."],
     :item/answer ["Con este método no pueden olvidar los verbos."]}
    {:item/n 3,
     :item/prompt ["Do you all want to see our house?"],
     :item/answer ["¿Quieren ver nuestra casa?"]}
    {:item/n 4,
     :item/prompt ["You all need to listen to the CDs every day."],
     :item/answer ["Necesitan escuchar los CDs cada día."]}
    {:item/n 5,
     :item/prompt ["Do you all want to find a hotel now?"],
     :item/answer ["¿Quieren encontrar un hotel ahora?"]}
    {:item/n 6,
     :item/prompt ["Do you all want to go to a party in our house this weekend."],
     :item/answer ["¿Quieren ir a una fiesta en nuestra casa este fin de semana?"]}
    {:item/n 7,
     :item/prompt ["Can you all listen to me please?"],
     :item/answer ["¿Pueden escucharme por favor?"]}
    {:item/n 8,
     :item/prompt ["It is important, you all need to listen to him."],
     :item/answer ["Es importante, necesitan escucharlo."]}
    {:item/n 9,
     :item/prompt ["Do you all want to go with us in order to (know) meet our Mexican friends?"],
     :item/answer ["¿Quieren ir con nosotros para conocer nuestros amigos mexicanos?"]}
    {:item/n 10,
     :item/prompt ["We need to rent a car. What type of car do you all want? We want a big car."],
     :item/answer
     ["Necesitamos rentar un coche. ¿Qué tipo de coche quieren? Queremos un coche grande."]}
    {:item/n 11,
     :item/prompt
     ["What documentation do we need to travel in Mexico? You all need a visa and passport."],
     :item/answer
     ["¿Qué documentación necesitamos para viajar en México? Necesitan visa y pasaporte."]}
    {:item/n 12,
     :item/prompt
     ["You all need to invite the professor to your party. But we don't want (to). Why don't you all want to invite him? Because we don't like the professor."],
     :item/answer
     ["Necesitan invitar al profesor a su fiesta. Pero no queremos. ¿Por qué no quieren invitarlo? Porque no nos gusta el profesor."]}
    {:item/n 13,
     :item/prompt
     ["Where do you all want to rent this summer? We want to rent a house on the Mayan Riviera."],
     :item/answer
     ["¿Dónde quieren rentar este verano? Queremos rentar una casa en la Riviera Maya."]}
    {:item/n 14,
     :item/prompt ["What do you all want to do in summer? We want to rest on the beach."],
     :item/answer ["¿Qué quieren hacer en verano? Queremos descansar en la playa."]}
    {:item/n 15,
     :item/prompt
     ["Do you all want to go to a typical restaurant? Yes, we like to know the traditional food."],
     :item/answer
     ["¿Quieren ir a un restaurante típico? Sí, nos gusta conocer la comida tradicional."]}
    {:item/n 16,
     :item/prompt
     ["Do you all want to work in Mexico in summer? Yes, we want to work as teachers of English."],
     :item/answer
     ["¿Quieren trabajar en México en verano? Sí, queremos trabajar como maestros de inglés."]}
    {:item/n 17,
     :item/prompt ["You all can practice Spanish with us? Yes, we want to practice with you all."],
     :item/answer ["Pueden practicar español con nosotros. Sí, queremos practicar con ustedes."]}
    {:item/n 18,
     :item/prompt ["You all need to learn more Spanish in order to speak with us."],
     :item/answer ["Necesitan aprender más español para hablar con nosotros."]}
    {:item/n 19,
     :item/prompt
     ["Do you all want to go to Mexico with us in summer? Yes, we want to, but we can’t, we have other plans."],
     :item/answer
     ["¿Quieren ir a México con nosotros en verano? Sí, queremos, pero no podemos,tenemos otros planes."]}
    {:item/n 20,
     :item/prompt
     ["When do we need to be in the restaurant? You all need to be there at 8:00 p.m. * The verb to hear in Spanish is oir. However, it is very common for Spanish speakers to use the verb escuchar when in English we would say to hear."],
     :item/answer
     ["¿Cuándo necesitamos estar en el restaurante? Necesitan estar allá a las 8:00 p.m."]}],
   :exercise/notes []}
