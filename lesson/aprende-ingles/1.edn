 :lesson/title "Tus primeros bloques de inglés",
 :lesson/target-title "Your first English chunks",
 :lesson/label "Lección 1",
 :lesson/sections
 [{:section/type :communication-multiplied,
   :section/id 1,
   :section/title "La negación con don't",
   :section/body
   ["En inglés, para negar usas don't antes del verbo: I don't want, I don't need."
    "La estructura es: sujeto + don't + verbo base."
    "I want = quiero; I don't want = no quiero."
    "I need = necesito; I don't need = no necesito."
    "Con he, she o it usa doesn't: she doesn't want."]}
  {:section/type :speaking-hints,
   :section/id nil,
   :section/title nil,
   :section/body
   ["Ya tienes dos verbos muy útiles: want y need."
    "Después de want y need puedes usar otro verbo con to: I want to eat, I need to go."
    "Esos segundos verbos son los verbos base: eat, go, see, speak."]}],
 :lesson/number 1,
 :lesson/intro [],
 :lesson/step {:step/number 1, :step/title "Primeros pasos para hablar inglés"},
 :lesson/closing
 ["Eso es todo por hoy."
  "Mañana añadiremos palabras que unen las frases y te permiten decir mucho más."
  "Con pocas palabras ya puedes comunicar bastante; cada lección multiplicará tu inglés."
  "No solo sumas palabras: multiplicas posibilidades."
  "Hasta mañana."],
