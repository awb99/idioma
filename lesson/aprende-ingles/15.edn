 :lesson/title "Verbos irregulares y pronombres",
 :lesson/target-title "Irregular verbs and pronouns",
 :lesson/label "Lección 15",
 :lesson/sections
 [{:section/type :accuracy-pointer,
   :section/id 12,
   :section/title "Verbos irregulares",
   :section/body
   ["Algunos verbos cambian en la tercera persona: I can, she can; I have, she has."
    "can no añade -s: he can, no *he cans*."
    "have añade -s: he has."
    "Recuerda las formas irregulares más comunes: can, have, do, go."]}
  {:section/type :communication-multiplied,
   :section/id 12,
   :section/title "You want to see us",
   :section/body
   ["El pronombre us va después del verbo: You want to see us."
    "us = nos; me = me; him = lo; her = la; them = los/las."
    "La estructura es: sujeto + want + to + verbo + us."
    "You want to see us = quieres vernos."]}],
