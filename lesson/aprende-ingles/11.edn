   :exercise/items
   [{:item/n 1,
     :item/prompt ["You have to learn more Spanish in order to speak with him."],
     :item/answer ["Tiene que aprender más español para hablar con él."]}
    {:item/n 2,
     :item/prompt ["Can you be here this afternoon?"],
     :item/answer ["¿Puede estar aquí esta tarde?"]}
    {:item/n 3,
     :item/prompt ["Can you help me with the Spanish tonight?"],
     :item/answer ["¿Puede ayudarme con el español esta noche?"]}
    {:item/n 4,
     :item/prompt ["I would like to visit the cathedral this afternoon."],
     :item/answer ["Me gustaría visitar la catedral esta tarde."]}
    {:item/n 5,
     :item/prompt ["Can you work in the afternoon?"],
     :item/answer ["¿Puede trabajar en la tarde?"]}
    {:item/n 6,
     :item/prompt ["You have to study with David every day."],
     :item/answer ["Tiene que estudiar con David cada día."]}
    {:item/n 7,
     :item/prompt ["Can you go with him to the dentist this afternoon."],
     :item/answer ["¿Puede ir con él al dentista esta tarde?"]}
    {:item/n 8,
     :item/prompt ["Why do you have to go with him to the school? In order to see the teacher."],
     :item/answer ["¿Por qué tiene que ir con él a la escuela? Para ver a la maestra."]}
    {:item/n 9,
     :item/prompt
     ["You can study with Miguel. Yes, I am going to study with him every afternoon in the cafeteria."],
     :item/answer
     ["Puede estudiar con Miguel. Sí, voy a estudiar con él cada tarde en la cafetería."]}
    {:item/n 10,
     :item/prompt ["You have to call your husband. Yes, I am going to call him right now."],
     :item/answer ["Tiene que llamar a su esposo. Sí, voy a llamarlo ahora mismo."]}
    {:item/n 11,
     :item/prompt ["Can you finish now? No, I have to continue."],
     :item/answer ["¿Puede terminar ahora? No, tengo que continuar."]}
    {:item/n 12,
     :item/prompt
     ["You need to speak more Spanish with him. Yes, I am going to speak with him every day."],
     :item/answer ["Necesita hablar más español con él. Sí, voy a hablar con él cada día."]}
    {:item/n 13,
     :item/prompt
     ["Would you like to see the football on television with him this afternoon? I am sorry, I need to work this afternoon."],
     :item/answer
     ["¿Le gustaría ver el fútbol por televisión con él esta tarde? Lo siento, necesito trabajar esta tarde."]}
    {:item/n 14,
     :item/prompt
     ["Can you come back in the afternoon? No, I can’t come back until tomorrow afternoon."],
