 :lesson/label "Lección 11",
 :lesson/sections
 [{:section/type :accuracy-pointer,
   :section/id 9,
   :section/title "Tomorrow afternoon",
   :section/body
   ["Para decir mañana por la tarde dices tomorrow afternoon."
    "Tomorrow night = mañana por la noche."
    "En inglés no se dice *tomorrow in the afternoon*; se omite la preposición."
    "Esta noche = tonight."]}
  {:section/type :accuracy-pointer,
   :section/id 10,
   :section/title "He, him y the",
   :section/body
   ["En inglés he es el pronombre de sujeto y him el de objeto."
    "He is Mexican = él es mexicano; I see him = lo veo."
    "the no cambia: the Mexican = el mexicano."
    "Con preposición usas him: with him = con él."]}],
