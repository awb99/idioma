   :exercise/items
   [{:item/n 1,
     :item/prompt
     ["We need to drive for a day in order to arrive at Los Cabos in the morning early."],
     :item/answer
     ["Necesitamos manejar por un día para llegar a Los Cabos en la mañana temprano."]}
