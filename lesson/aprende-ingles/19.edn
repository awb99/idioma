 :lesson/label "Lección 19",
 :lesson/sections
 [{:section/type :communication-multiplied,
   :section/id 17,
   :section/title "You all: más ejemplos",
   :section/body
   ["you all también usa el verbo base: you all want, you all need, you all can."
    "Con be: you all are going to; con have: you all have to."
    "En inglés no se añade -n como en español (quieren, necesitan)."
    "El contexto o la palabra all aclaran que hablas de varias personas."]}
  {:section/type :accuracy-pointer,
   :section/id 16,
   :section/title "Yes e if",
   :section/body
   ["Yes se pronuncia «yes» e if se pronuncia «if»."
    "No cambian de forma como sí y si en español."
    "La diferencia está en el contexto y en la pronunciación."
    "If introduce una condición: if you want, we can go."]}],
 :lesson/number 19,
