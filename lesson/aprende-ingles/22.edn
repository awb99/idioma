 :lesson/label "Lección 22",
 :lesson/sections
 [{:section/type :communication-multiplied,
   :section/id 19,
   :section/title "He, she y you",
   :section/body
   ["En inglés el verbo cambia en la tercera persona del singular: he works, she needs."
    "Para preguntar con he o she usas does: Does he work?"
    "Para negar usas doesn't: She doesn't work."
    "El pronombre se usa casi siempre en inglés, a diferencia del español."]}],
 :lesson/number 22,
