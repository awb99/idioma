  {:exercise/id "9B"
   :exercise/skill :translate
   :exercise/direction :to-english
   :exercise/dialog? false
   :exercise/instructions "You’ll start using Spanish dialog shortly. But before you practice two part Spanish conversations in exercise 9C, get the feel for 2nd person Spanish in this exercise."
   :exercise/hints ["en casa = at home" "agua = water" "y = and"]
   :exercise/items
   [{:item/n 1
     :item/prompt ["Para ver la luna no necesita un telescopio."]
     :item/answer ["In order to see the moon you don't need a telescope."]}
    {:item/n 2
     :item/prompt ["Necesita estudiar mucho español para hablar en sus vacaciones."]
     :item/answer ["You need to study a lot of Spanish in order to speak in your vacation."]}
    {:item/n 3
     :item/prompt ["¿Quiere invitar a la maestra a la fiesta?"]
     :item/answer ["Do you want to invite the teacher to the party?"]}
    {:item/n 4
     :item/prompt ["¿Cuándo quiere visitar a su familia?"]
     :item/answer ["When do you want to visit your family?"]}
    {:item/n 5
     :item/prompt ["¿Quiere rentar o comprar una casa?"]
     :item/answer ["Do you want to rent or buy a house?"]}
    {:item/n 6
     :item/prompt
     ["¿Quiere regresar al restaurante otra vez para comer más de los tacos deliciosos?"]
     :item/answer
     ["Do you want to go back (return) to the restaurant again to eat more of the delicious tacos?"]}
    {:item/n 7
     :item/prompt ["Necesita regresar el video a Blockbuster."]
     :item/answer ["You need to return the video to Blockbuster."]}
    {:item/n 8
     :item/prompt ["Necesita estar en casa con su familia esta noche."]
     :item/answer ["You need to be at home with your family tonight."]}
    {:item/n 9
     :item/prompt ["Necesita pasar más tiempo conmigo y con su familia."]
     :item/answer ["You need to spend more time with me and with your family."]}
    {:item/n 10
     :item/prompt ["¿Quiere rentar una casa en Puerto Vallarta este año?"]
     :item/answer ["Do you want to rent a house in Puerto Vallarta this year?"]}
    {:item/n 11
     :item/prompt ["¿Quiere trabajar en México este año?"]
     :item/answer ["Do you want to work in Mexico this year?"]}
    {:item/n 12
     :item/prompt ["¿Quiere regresar al restaurante mañana en la noche?"]
     :item/answer ["Do you want to go back (return) to the restaurant tomorrow night?"]}
    {:item/n 13
     :item/prompt ["Necesita pasar la noche en un hotel."]
     :item/answer ["You need to spend the night in a hotel."]}
    {:item/n 14
     :item/prompt ["Necesita tomar mucha agua en el desierto."]
     :item/answer ["You need to drink a lot of water in the desert."]}
    {:item/n 15
     :item/prompt ["¿Cuándo quiere regresar a México?"]
     :item/answer ["When do you want to go back (return) to Mexico?"]}
    {:item/n 16
     :item/prompt ["¿Quiere ir a mi casa por un rato para ver a mi familia?"]
     :item/answer ["Do you want to go to my house for a while in order to see my family?"]}
    {:item/n 17
     :item/prompt ["Necesita continuar mañana."]
     :item/answer ["You need to continue tomorrow."]}
    {:item/n 18
     :item/prompt ["¿Quiere trabajar esta noche o mañana?"]
     :item/answer ["Do you want to work tonight or tomorrow?"]}
    {:item/n 19
     :item/prompt ["Señor, necesita ir al doctor pronto."]
     :item/answer ["Sir, you need to go to the doctor soon."]}
    {:item/n 20
     :item/prompt ["Necesita hablar más español."]
     :item/answer ["You need to speak more Spanish."]}]
   :exercise/notes []}
  {:exercise/id "9C"
   :exercise/skill :translate
   :exercise/direction :to-english
   :exercise/dialog? true
   :exercise/instructions "As promised it is time for dialog. I am sure you will be able to understand these two part conversations."
   :exercise/hints ["sólo = only"]
   :exercise/items
   [{:item/n 1
     :item/prompt
     ["¿Necesita viajar esta semana?" "No, voy a estar en casa hasta la próxima semana."]
     :item/answer
     ["Do you need to travel this week?" "No, I am going to be home until (the) next week."]}
    {:item/n 2
     :item/prompt
     ["¿Quiere trabajar conmigo en el proyecto?"
      "Sí, puedo trabajar con usted la próxima semana."]
     :item/answer
     ["Do you want to work with me on the project?" "Yes, I can work with you (the) next week."]}
    {:item/n 3
     :item/prompt
     ["¿Quiere tomar un tequila conmigo?" "Gracias, pero no me gusta mucho el tequila."]
     :item/answer
     ["Do you want to drink a tequila with me?" "Thank you, but I don't much like tequila."]}
    {:item/n 4
     :item/prompt
     ["¿Quiere hablar español conmigo?"
      "Sí, me gustaría mucho la oportunidad para practicar español con usted."]
     :item/answer
     ["Do you want to speak Spanish with me?"
      "Yes, I would like (very) much the opportunity (in order) to practice Spanish with you."]}
    {:item/n 5
     :item/prompt
     ["¿Necesita hablar español en la compañía?"
      "Sí, necesito hablar español cada día con mis clientes."]
     :item/answer
     ["Do you need to speak Spanish in the company?"
      "Yes, I need to speak Spanish every day with my clients."]}
    {:item/n 6
     :item/prompt
     ["¿Quiere comer en un restaurante tradicional?"
      "Francamente no, esta noche preferiría comer comida americana."]
     :item/answer
     ["Do you want to eat in a traditional restaurant?"
      "Frankly no, tonight I would prefer to eat American food."]}
    {:item/n 7
     :item/prompt
     ["¿Quiere comer en el restaurante esta noche?" "Sí, ¿puedo invitar a un amigo?"]
     :item/answer
     ["Do you want to eat in the restaurant tonight?" "Yes, can I invite a friend?"]}
    {:item/n 8
     :item/prompt
     ["¿Quiere ir a España en mayo conmigo?" "Quiero ir, pero no puedo, tengo que trabajar."]
     :item/answer
     ["Do you want to go to Spain in May with me?" "I want to go, but I can’t, I have to work."]}
    {:item/n 9
     :item/prompt
     ["¿Cuándo necesita ir al hotel?" "Necesito ir pronto para confirmar la reservación."]
     :item/answer
     ["When do you need to go to the hotel?"
      "I need to go soon in order to confirm the reservation."]}
    {:item/n 10
     :item/prompt
     ["¿Quiere comer un burrito en el mercado?"
      "Quiero comer en el mercado pero prefiero enchiladas que burritos."]
     :item/answer
     ["Do you want to eat a burrito in the market?"
      "I want to eat in the market, but I prefer enchiladas (than) to burritos."]}
    {:item/n 11
     :item/prompt ["¿Quiere ver el menú?" "No, sólo quiero un café por favor."]
     :item/answer ["Do you want to see the menu?" "No, I only want a coffee please."]}
    {:item/n 12
     :item/prompt ["¿Quiere ir a una fiesta conmigo?" "Sí, ¿cuándo es la fiesta?"]
     :item/answer ["Do you want to go to a party with me?" "Yes, when is the party?"]}
    {:item/n 13
     :item/prompt
     ["¿Necesita hablar español?" "Sí, necesito hablar español, es muy importante para mí."]
     :item/answer
     ["Do you need to speak Spanish?"
      "Yes, I need to speak Spanish, it is very important for me."]}
    {:item/n 14
     :item/prompt ["¿Quiere comer algo diferente?" "Depende!"]
     :item/answer ["Do you want to eat something different?" "It depends."]}
    {:item/n 15
     :item/prompt
     ["¿Quiere ver los Mariachis en Plaza Garibaldi esta noche?"
      "Sí, quiero pero tengo que estar en el aeropuerto a las 8:00 p.m."]
     :item/answer
     ["Do you want to see the mariachis in Plaza Garibaldi tonight?"
      "Yes, I want to but I have to be (in) at the airport at 8:00 p.m."]}
    {:item/n 16
     :item/prompt
     ["¿Necesita ver los pasaportes?" "Sí, necesito ver los pasaportes y las visas."]
     :item/answer
     ["Do you need to see the passports?" "Yes, I need to see the passports and the visas."]}]
   :exercise/notes []}
