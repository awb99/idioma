  {:exercise/id "9E"
   :exercise/skill :translate
   :exercise/direction :to-spanish
   :exercise/dialog? true
   :exercise/instructions "Now it is time for you to create your own Spanish dialog."
   :exercise/hints []
   :exercise/items
   [{:item/n 1
     :item/prompt ["When do you need to see the doctor?" "Tomorrow."]
     :item/answer ["¿Cuándo necesita ver al doctor?" "Mañana."]}
    {:item/n 2
     :item/prompt ["When do you need to go?" "I need to go tomorrow."]
     :item/answer ["¿Cuándo necesita ir?" "Necesito ir mañana."]}
    {:item/n 3
     :item/prompt ["When do you want to eat?" "I want to eat now."]
     :item/answer ["¿Cuándo quiere comer?" "Quiero comer ahora."]}
    {:item/n 4
     :item/prompt ["Do you want to see my house?" "Yes, I would like to see your house."]
     :item/answer ["¿Quiere ver mi casa?" "Sí, me gustaría ver su casa."]}
    {:item/n 5
     :item/prompt
     ["When do you need to go back to your house?" "I need to go back tomorrow night."]
     :item/answer
     ["¿Cuándo necesita regresar a su casa?" "Necesito regresar mañana en la noche."]}
    {:item/n 6
     :item/prompt
     ["Do you want to eat in my house or do you want to eat in a restaurant?"
      "I would like (very) much to eat in your house."]
     :item/answer
     ["¿Quiere comer en mi casa, o quiere comer en un restaurante?"
      "Me gustaría mucho comer en su casa."]}
    {:item/n 7
     :item/prompt
     ["Do you want to go to Tijuana tonight?" "No, I don't like to go to Tijuana in the night."]
     :item/answer
     ["¿Quiere ir a Tijuana esta noche?" "No, no me gusta ir a Tijuana en la noche."]}
    {:item/n 8
     :item/prompt ["Do you want more?" "No, I don’t want (any) more,thank you."]
     :item/answer ["¿Quiere más?" "No, no quiero más, gracias."]}
    {:item/n 9
     :item/prompt
     ["You need to help your dad tomorrow." "I can’t, I have to go to the doctor."]
     :item/answer ["Necesita ayudar a su papá mañana." "No puedo, tengo que ir al doctor."]}
    {:item/n 10
     :item/prompt
     ["Do you want to visit Mexico again?" "Yes, I want to go back (the) next year."]
     :item/answer ["¿Quiere visitar México otra vez?" "Sí, quiero regresar el próximo año"]}
    {:item/n 11
     :item/prompt
     ["Do you want to go to a party in my house (the) next weekend?"
      "Yes, I would like to go but I can’t."]
     :item/answer
     ["¿Quiere ir a una fiesta en mi casa el próximo fin de semana?"
      "Sí, me gustaría ir pero no puedo."]}
    {:item/n 12
     :item/prompt ["Do you need to go to Mexico?" "Yes, I have to go tomorrow."]
     :item/answer ["¿Necesita ir a México?" "Sí, tengo que ir mañana."]}
    {:item/n 13
     :item/prompt
     ["Do you want to go to a restaurant with me?" "Yes, I would like to go with you."]
     :item/answer ["¿Quiere ir a un restaurante conmigo?" "Sí, me gustaría ir con usted."]}
    {:item/n 14
     :item/prompt
     ["Do you want to eat with me in the restaurant tonight?"
      "Yes, I would like (very) much to eat with you."]
     :item/answer
     ["¿Quiere comer conmigo en el restaurante esta noche?"
      "Sí, me gustaría mucho comer con usted."]}
    {:item/n 15
     :item/prompt
     ["You need to go with me (in order) to see my mom." "Yes, I am going to go with you."]
     :item/answer ["Necesita ir conmigo para ver a mi mamá." "Sí, voy a ir con usted."]}
    {:item/n 16
     :item/prompt
     ["Do you want to go back with me?" "Thank you, but I am going to go back with Mario."]
     :item/answer ["¿Quiere regresar conmigo?" "Gracias, pero voy a regresar con Mario."]}
    {:item/n 17
     :item/prompt ["You need to work with me today." "Yes, I am going to work with you."]
     :item/answer ["Necesita trabajar conmigo hoy." "Sí, voy a trabajar con usted."]}
    {:item/n 18
     :item/prompt
     ["Do you want to spend the weekend with me in Mexico?"
      "I am sorry, but I can’t, I have to work."]
     :item/answer
     ["¿Quiere pasar el fin de semana conmigo en México?"
      "Lo siento, pero no puedo, tengo que trabajar."]}]
   :exercise/notes []}]
