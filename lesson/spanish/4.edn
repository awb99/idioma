  {:exercise/id "4B"
   :exercise/skill :translate
   :exercise/direction :to-english
   :exercise/dialog? false
   :exercise/instructions "These Spanish sentences are getting longer and more complex. Remember I promised real Spanish. This is real Spanish and you already know enough to understand it."
   :exercise/hints ["Maleta = case" "del = of the" "por = for/by"]
   :exercise/items
   [{:item/n 1
     :item/prompt ["Esta noche me gustaría ir al cine con mis amigos."]
     :item/answer ["Tonight I would like to go to the cinema with my friends."]}
    {:item/n 2
     :item/prompt ["Me gustaría comer en el restaurante con usted otra vez."]
     :item/answer ["I would like to eat in the restaurant with you again."]}
    {:item/n 3
     :item/prompt ["Necesito hablar con mi esposa por teléfono otra vez."]
     :item/answer ["I need to speak with my wife by telephone again."]}
    {:item/n 4
     :item/prompt ["Necesito llamar al hotel para confirmar la reservación de mañana."]
     :item/answer
     ["I need to call the hotel in order to confirm the reservation of tomorrow (tomorrow’s reservation)."]}
    {:item/n 5
     :item/prompt ["Esta noche me gustaría ir a un bar con mis amigos."]
     :item/answer ["Tonight I would like to go to a bar with my friends."]}
    {:item/n 6
     :item/prompt ["Voy a visitarla otra vez en mayo."]
     :item/answer ["I am going to visit her again in May."]}
    {:item/n 7
     :item/prompt ["Voy a estudiar español en un curso de tres semanas."]
     :item/answer ["I am going to study Spanish in a 3 week course."]}
    {:item/n 8
     :item/prompt ["Voy a ayudarla con las maletas."]
     :item/answer ["I am going to help her with the cases."]}
    {:item/n 9
     :item/prompt ["Me gustaría ir a la catedral esta semana."]
     :item/answer ["I would like to go to the cathedral this week."]}
    {:item/n 10
     :item/prompt ["Voy a ir a Guatemala por tres semanas."]
     :item/answer ["I am going to go to Guatemala for three weeks."]}
    {:item/n 11
     :item/prompt ["Quiero ayudarlo con el estudio del español."]
     :item/answer ["I want to help him with the study of (the) Spanish."]}
    {:item/n 12
     :item/prompt ["Quiero rentar esta casa."]
     :item/answer ["I want to rent this house."]}
    {:item/n 13
     :item/prompt ["Esta semana y la próxima necesito estudiar mucho."]
     :item/answer ["This week and the next I need to study a lot."]}
    {:item/n 14
     :item/prompt ["Necesito un hotel por dos semanas."]
     :item/answer ["I need a hotel for two weeks."]}
    {:item/n 15
     :item/prompt
     ["Me gustaría invitar a José a mi fiesta de graduación la próxima semana."]
     :item/answer ["I would like to invite Jose to my graduation party the next week."]}
    {:item/n 16
     :item/prompt
     ["La próxima semana, voy a ir a las pirámides en Yucatán con un grupo de amigos."]
     :item/answer
     ["(The) next week, I am going to go to the pyramids in Yucatan with a group of friends."]}
    {:item/n 17
     :item/prompt ["Quiero verlo en la clase de español con más frecuencia."]
     :item/answer
     ["I want to see him in the Spanish class with more frequency (more often)."]}
    {:item/n 18
     :item/prompt ["Necesito ir al dentista esta semana."]
     :item/answer ["I need to go to the dentist this week."]}
    {:item/n 19
     :item/prompt ["Voy a hablar con el policía para reportar el robo."]
     :item/answer ["I am going to speak with the policeman to report the robbery."]}
    {:item/n 20
     :item/prompt ["Necesito ver la visa y el pasaporte otra vez."]
     :item/answer ["I need to see the visa and the passport again."]}
    {:item/n 21
     :item/prompt ["Voy a hablar más español con los mexicanos en mis vacaciones."]
     :item/answer ["I am going to speak more Spanish with the Mexicans in my vacation."]}]
