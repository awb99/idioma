     :item/answer ["When are you going to call her?"]}
    {:item/n 18,
     :item/prompt ["¿Le gustaría tomar un café aquí?"],
     :item/answer ["Would you like to drink a coffee here?"]}],
   :exercise/notes []}
  {:exercise/id "10C",
   :exercise/skill :translate,
   :exercise/direction :to-base,
   :exercise/dialog? true,
   :exercise/instructions
   "Now we´ll expand the Spanish dialogs, plus add a few new words. See if you can figure out the new words from the context.",
   :exercise/hints ["tomar = drink / take"],
   :exercise/items
   [{:item/n 1,
     :item/prompt
     ["¿Por qué no quiere tomar un tequila conmigo?" "Lo siento, pero no puedo tomar alcohol."],
