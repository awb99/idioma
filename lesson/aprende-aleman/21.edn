{:lesson/vocabulary [],
 :lesson/title "Fin del paso 4: los pronombres de objeto en alemán",
 :lesson/target-title "Ende von Schritt 4: Objektpronomen",
 :lesson/label "Lección 21",
 :lesson/sections
 [{:section/type :communication-multiplied,
   :section/id 18,
   :section/title "Pronombres de objeto en alemán",
   :section/body
   ["En alemán el objeto directo va en acusativo: mich, dich, ihn, sie, es, uns, euch, sie/Sie."
    "El objeto indirecto va en dativo: mir, dir, ihm, ihr, ihm, uns, euch, ihnen/Ihnen."
    "El pronombre va después del verbo o de la preposición: Ich sehe ihn. Mit ihr."
    "El alemán distingue acusativo y dativo; helfen, danken y antworten rigen dativo: Ich helfe ihm."]}],
 :lesson/number 21,
 :lesson/intro [],
 :lesson/step {:step/number 4, :step/title "Ellos también hablan, ¿no?"},
 :lesson/closing ["¡Enhorabuena! Has terminado el paso 4."],
 :lesson/exercises
 [{:exercise/id "21A",
