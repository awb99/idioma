          #:exercise{:id "12B",
                     :skill :translate,
                     :direction :to-base,
                     :dialog? false,
                     :instructions "Traduce estas frases al español.",
                     :hints ["llamada = der Anruf"],
                     :items
                     [#:item{:n 1,
                             :prompt
                             ["Ich kann vor Dezember nicht mit ihm reisen."],
                             :answer
                             ["No puedo viajar con él antes de diciembre."]}
                      #:item{:n 2,
                             :prompt
                             ["Was wollen Sie heute machen? Ich will ins Kino gehen."],
                             :answer
                             ["¿Qué quiere hacer hoy? Quiero ir al cine."]}
                      #:item{:n 3,
                             :prompt
                             ["Ich sehe meine Freunde gern am Wochenende."],
                             :answer
                             ["Me gusta ver a mis amigos los fines de semana."]}
                      #:item{:n 4,
                             :prompt
                             ["Ich frühstücke gern am Wochenende in diesem Restaurant."],
                             :answer
                             ["Me gusta desayunar en este restaurante los fines de semana."]}
                      #:item{:n 5,
                             :prompt ["Sie mögen keinen Fußball!"],
                             :answer ["!No le gusta el fútbol!"]}
                      #:item{:n 6,
                             :prompt
                             ["Was wollen Sie trinken, Tee oder Kaffee?"],
                             :answer ["¿Qué quiere tomar té o café?"]}
                      #:item{:n 7,
                             :prompt
                             ["Ich werde zum Hotel zurückkommen, bevor ich ins Restaurant gehe."],
                             :answer
                             ["Voy a regresar al hotel antes de ir al restaurante."]}
                      #:item{:n 8,
                             :prompt
                             ["Sie können hier eine Weile lernen, bevor Sie nach Hause zurückkehren."],
                             :answer
                             ["Puede estudiar aquí por un rato antes de regresar a su casa."]}
                      #:item{:n 9,
                             :prompt
                             ["Ich will im Park zu Fuß gehen."],
                             :answer ["Quiero caminar en el parque."]}
                      #:item{:n 10,
                             :prompt
                             ["Sie müssen vor dem Wochenende fertig werden."],
                             :answer
                             ["Tiene que terminar antes del fin de semana."]}
                      #:item{:n 11,
                             :prompt
                             ["Werden Sie vor dem nächsten Jahr zurückkehren?"],
                             :answer
                             ["¿Va a regresar antes del próximo año?"]}
                      #:item{:n 12,
                             :prompt
                             ["Sie können mit ihm zu Fuß zum Hotel gehen."],
                             :answer
                             ["Puede caminar con él al hotel."]}
                      #:item{:n 13,
                             :prompt
                             ["Mögen Sie es, mit ihm zu lernen?"],
                             :answer ["¿Le gusta estudiar con él?"]}
                      #:item{:n 14,
                             :prompt
                             ["Ich muss eine Reservierung machen."],
                             :answer
                             ["Tengo que hacer una reservación."]}
                      #:item{:n 15,
                             :prompt
                             ["Ich muss sofort einen Anruf machen."],
                             :answer
                             ["Necesito hacer una llamada ahora mismo."]}
                      #:item{:n 16,
                             :prompt
                             ["Können Sie mir helfen, bevor ich frühstücke?"],
                             :answer
                             ["¿Puede ayudarme antes de desayunar?"]}
                      #:item{:n 17,
                             :prompt
                             ["Ich möchte hier einen Kaffee trinken, bevor ich zum Hotel zurückkehre."],
                             :answer
                             ["Me gustaría tomar un café aquí antes de regresar al hotel."]}
                      #:item{:n 18,
                             :prompt ["Warum reisen Sie nicht gern?"],
                             :answer ["¿Por qué no le gusta viajar?"]}
                      #:item{:n 19,
                             :prompt
                             ["Ich werde vor dem Jahresende einen Monat dort verbringen."],
                             :answer
                             ["Voy a pasar un mes allá antes del fin de año."]}
                      #:item{:n 20,
                             :prompt
                             ["Sie können nicht zu Fuß gehen, Sie müssen mit dem Taxi fahren."],
                             :answer
                             ["No puede caminar, necesita ir en taxi."]}
                      #:item{:n 21,
                             :prompt ["Ich muss mal pinkeln."],
                             :answer ["Necesito hacer pipi."]}
                      #:item{:n 22,
                             :prompt
                             ["Gehen Sie am Wochenende gern in die Bars in Tijuana?"],
                             :answer
                             ["¿Le gusta ir a los bares en Tijuana los fines de semana?"]}
                      #:item{:n 23,
                             :prompt ["Sind Sie gern zu Hause?"],
                             :answer ["¿Le gusta estar en casa?"]}
                      #:item{:n 24,
                             :prompt
                             ["Sie müssen hier einen Doppelklick machen."],
                             :answer
                             ["Necesita hacer un doble clic aquí."]}
                      #:item{:n 25,
                             :prompt
                             ["Werden Sie zu Fuß gehen oder ein Taxi nehmen?"],
                             :answer
                             ["¿Va a caminar o va a tomar un taxi?"]}
                      #:item{:n 26,
                             :prompt
                             ["Ich will keinen Kommentar machen."],
                             :answer
                             ["No quiero hacer un comentario."]}
                      #:item{:n 27,
                             :prompt
                             ["Mögen Sie mexikanisches Essen?"],
                             :answer ["¿Le gusta la comida mexicana?"]}
                      #:item{:n 28,
                             :prompt
                             ["Ich muss vor heute Abend mit meiner Frau sprechen."],
                             :answer
                             ["Necesito hablar con mi esposa antes de esta noche."]}],
                     :notes []}
