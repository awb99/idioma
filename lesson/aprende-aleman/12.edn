          #:exercise{:id "12D",
                     :skill :translate,
                     :direction :to-target,
                     :dialog? false,
                     :instructions "Traduce estas frases al alemán.",
                     :hints ["un doctor = ein Arzt"],
                     :items
                     [#:item{:n 1,
                             :prompt ["¿Qué va a hacer esta tarde?"],
                             :answer
                             ["Was werden Sie heute Nachmittag machen?"]}
                      #:item{:n 2,
                             :prompt
                             ["Necesito trabajar otra vez en San Diego antes de la próxima semana."],
                             :answer
                             ["Ich muss vor der nächsten Woche wieder in San Diego arbeiten."]}
                      #:item{:n 3,
                             :prompt ["¿Qué quiere para desayunar?"],
                             :answer ["Was wollen Sie zum Frühstück?"]}
                      #:item{:n 4,
                             :prompt
                             ["Voy a trabajar allá con él antes del próximo mes."],
                             :answer
                             ["Ich werde vor dem nächsten Monat mit ihm dort arbeiten."]}
                      #:item{:n 5,
                             :prompt ["¿Le gusta trabajar con él?"],
                             :answer ["Arbeiten Sie gern mit ihm?"]}
                      #:item{:n 6,
                             :prompt
                             ["No voy a regresar antes del próximo año."],
                             :answer
                             ["Ich werde nicht vor dem nächsten Jahr zurückkehren."]}
                      #:item{:n 7,
                             :prompt ["¿Qué le gustaría tomar?"],
                             :answer ["Was möchten Sie trinken?"]}
                      #:item{:n 8,
                             :prompt ["Quiero caminar."],
                             :answer ["Ich will zu Fuß gehen."]}
                      #:item{:n 9,
                             :prompt ["Puedo desayunar en el hotel."],
                             :answer
                             ["Ich kann im Hotel frühstücken."]}
                      #:item{:n 10,
                             :prompt
                             ["Necesito pasar un día en LA antes de la próxima semana."],
                             :answer
                             ["Ich muss vor der nächsten Woche einen Tag in LA verbringen."]}
                      #:item{:n 11,
                             :prompt ["Tengo que caminar cada día."],
                             :answer
                             ["Ich muss jeden Tag zu Fuß gehen."]}
                      #:item{:n 12,
                             :prompt
                             ["¿Qué necesita? Necesito ver a un doctor ahora mismo."],
                             :answer
                             ["Was brauchen Sie? Ich muss sofort zum Arzt."]}
                      #:item{:n 13,
                             :prompt
                             ["¿Le gusta México? Sí, me gusta mucho."],
                             :answer
                             ["Mögen Sie Mexiko? Ja, ich mag es sehr."]}
                      #:item{:n 14,
                             :prompt
                             ["Lo siento, no puedo verlo antes de mañana."],
                             :answer
                             ["Es tut mir leid, ich kann ihn vor morgen nicht sehen."]}
                      #:item{:n 15,
                             :prompt
                             ["¿Le gusta estar aquí? Me gusta estar aquí con usted."],
                             :answer
                             ["Sind Sie gern hier? Ich bin gern hier mit Ihnen."]}
                      #:item{:n 16,
                             :prompt
                             ["¿Le gusta estudiar? Sí, me gusta estudiar, porque quiero aprender más español."],
                             :answer
                             ["Lernen Sie gern? Ja, ich lerne gern, weil ich mehr Spanisch lernen will."]}
                      #:item{:n 17,
                             :prompt ["Necesita caminar más."],
                             :answer ["Sie müssen mehr zu Fuß gehen."]}
                      #:item{:n 18,
                             :prompt
                             ["¿Le gusta cocinar? Sí, me gusta cocinar."],
                             :answer
                             ["Kochen Sie gern? Ja, ich koche gern."]}
                      #:item{:n 19,
                             :prompt
                             ["¿Qué quiere hacer esta noche? Quiero ir a un restaurante."],
                             :answer
                             ["Was wollen Sie heute Abend machen? Ich will in ein Restaurant gehen."]}
                      #:item{:n 20,
                             :prompt
                             ["Voy a hacer una fiesta en mi casa."],
                             :answer
                             ["Ich werde bei mir zu Hause eine Party feiern."]}
                      #:item{:n 21,
                             :prompt
                             ["No necesito un taxi, puedo caminar."],
                             :answer
                             ["Ich brauche kein Taxi, ich kann zu Fuß gehen."]}
                      #:item{:n 22,
                             :prompt ["¿Qué tiene que hacer ahora?"],
                             :answer ["Was müssen Sie jetzt machen?"]}
                      #:item{:n 23,
                             :prompt
                             ["¿Le gustaría hacer algo esta noche?"],
                             :answer
                             ["Möchten Sie heute Abend etwas machen?"]}],
