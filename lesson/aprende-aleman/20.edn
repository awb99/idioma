         :label "Lección 20",
         :sections
         [#:section{:type :accuracy-pointer,
                    :id 17,
                    :title "möchten: deseos y cortesía",
                    :body
                    ["möchten es el verbo modal para pedir o expresar un deseo con cortesía: Ich möchte einen Kaffee."
                     "Se conjuga: ich möchte, du möchtest, er/sie möchte, wir möchten, Sie möchten."
                     "El infinitivo va al final de la frase: Möchten Sie einen Kaffee trinken?"
                     "No digas «möchte mögen»; möchten ya significa «me gustaría»."]}],
         :number 20,
         :intro [],
         :step #:step{:number 4, :title "Ellos también hablan, ¿no?"},
         :closing
         ["Enhorabuena, casi has terminado el paso 4."
          "Ya no quedan verbos nuevos de este tipo."
          "En el paso 5 aprenderás las últimas palabras y estructuras."
          "Sigue así, vas muy bien."],
