          #:exercise{:id "20B",
                     :skill :translate,
                     :direction :to-base,
                     :dialog? false,
                     :instructions "Traduce estas frases al español.",
                     :hints
                     ["Stierkampf = corrida de toros"
                      "Zeitung = periódico"
                      "erste = primera"
                      "Wort = palabra"],
                     :items
                     [#:item{:n 1,
                             :prompt ["Sie müssen Spanisch üben."],
                             :answer ["Tienen que practicar español."]}
                      #:item{:n 2,
                             :prompt ["Lesen Sie gern die Zeitung?"],
                             :answer ["¿Le gusta leer el periódico?"]}
                      #:item{:n 3,
                             :prompt
                             ["Wenn Sie wollen, fahren wir früh los, um den Verkehr zu vermeiden."],
                             :answer
                             ["Si quieren, vamos a salir temprano para evitar el tráfico."]}
                      #:item{:n 4,
                             :prompt
                             ["Ich werde viel Spanisch mit meinen mexikanischen Freunden üben."],
                             :answer
                             ["Voy a practicar mucho español con mis amigos mexicanos."]}
                      #:item{:n 5,
                             :prompt
                             ["Möchten Sie die Speisekarte lesen?"],
                             :answer ["¿Les gustaría leer el menú?"]}
                      #:item{:n 6,
                             :prompt
                             ["Wann werden Sie zurückkommen? Wir werden nächstes Jahr zurückkommen, um hier zu leben."],
                             :answer
                             ["¿Cuándo van a regresar? Vamos a regresar el próximo año para vivir aquí."]}
                      #:item{:n 7,
                             :prompt ["Welches Essen mögen Sie?"],
                             :answer
                             ["¿Qué tipo de comida les gusta?"]}
                      #:item{:n 8,
                             :prompt
