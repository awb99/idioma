                      #:item{:n 13,
                             :prompt
                             ["Warum reisen Sie nicht gern nach Mexiko?"],
                             :answer
                             ["¿Por qué no les gusta viajar a México?"]}
                      #:item{:n 14,
                             :prompt
                             ["Mögen Sie mexikanisches Essen? Wir lieben mexikanisches Essen."],
                             :answer
                             ["¿Les gusta la comida mexicana? Nos encanta la comida mexicana."]}
                      #:item{:n 15,
                             :prompt
                             ["Möchten Sie hier einen Kaffee trinken?"],
                             :answer
                             ["¿Les gustaría tomar un café aquí?"]}
                      #:item{:n 16,
                             :prompt
