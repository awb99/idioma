         :title "Iniciadores y verbos útiles en alemán",
         :target-title "Satzanfänge und nützliche Verben",
         :label "Lección 7",
         :sections
         [#:section{:type :communication-multiplied,
                    :id 8,
                    :title "Iniciadores de frases",
                    :body
                    ["Es tut mir leid es un iniciador de frase: Es tut mir leid, ich kann Ihnen heute nicht helfen."
                     "También puede ir solo: Es tut mir leid."
                     "Otras fórmulas útiles: Entschuldigung (perdón) y Verzeihung."
                     "Los iniciadores te dan tiempo para pensar y suavizan lo que dices."]}
          #:section{:type :accuracy-pointer,
                    :id 5,
                    :title "Tiempo y dinero: verbringen y ausgeben",
                    :body
                    ["En alemán no hay un solo verbo para pasar y gastar: el tiempo se pasa con verbringen y el dinero se gasta con ausgeben."
                     "Ich verbringe Zeit = paso tiempo; ich gebe Geld aus = gasto dinero."
                     "ausgeben es un verbo separable: ich gebe ... aus."]}
          #:section{:type :accuracy-pointer,
                    :id 6,
                    :title "Trinken: beber o tomar",
                    :body
                    ["Para beber, el alemán usa trinken: Ich trinke Wasser."
                     "etwas trinken = tomar algo; trinken es el verbo general."
                     "No confundas trinken con essen (comer)."]}],
         :number 7,
         :intro [],
         :step
         #:step{:number 1, :title "Primeros pasos para hablar alemán"},
         :closing [],
