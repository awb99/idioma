          #:exercise{:id "19D",
                     :skill :translate,
                     :direction :to-target,
                     :dialog? false,
                     :instructions "Traduce estas frases al alemán.",
                     :hints
                     ["Hummer = langosta" "verstehen = comprender"],
                     :items
                     [#:item{:n 1,
                             :prompt
                             ["¿Qué quieren hacer el próximo verano? Queremos pasar el verano en México con nuestra familia."],
                             :answer
                             ["Was wollen Sie nächsten Sommer machen? Wir wollen den Sommer mit unserer Familie in Mexiko verbringen."]}
                      #:item{:n 2,
                             :prompt ["¿Cuándo van a visitarnos?"],
                             :answer ["Wann werden Sie uns besuchen?"]}
                      #:item{:n 3,
                             :prompt
                             ["¿Cuándo quieren verla? Vamos a verla mañana."],
                             :answer
                             ["Wann wollen Sie sie sehen? Wir werden sie morgen sehen."]}
                      #:item{:n 4,
                             :prompt
                             ["¿Cuándo van a llegar? Vamos a llegar mañana en la tarde."],
                             :answer
                             ["Wann werden Sie ankommen? Wir werden morgen Nachmittag ankommen."]}
                      #:item{:n 5,
                             :prompt
                             ["¿Cuándo necesitan llegar? Necesitamos llegar antes de esta noche."],
                             :answer
                             ["Wann müssen Sie ankommen? Wir müssen vor heute Abend ankommen."]}
                      #:item{:n 6,
                             :prompt
                             ["Lo siento, pero necesitan trabajar este fin de semana.!Otra vez tenemos que trabajar!"],
                             :answer
                             ["Es tut mir leid, aber Sie müssen dieses Wochenende arbeiten. Schon wieder müssen wir arbeiten!"]}
                      #:item{:n 7,
                             :prompt ["¿Donde van a esperarla?"],
                             :answer ["Wo werden Sie auf sie warten?"]}
                      #:item{:n 8,
                             :prompt
                             ["¿Quieren salir esta noche? No gracias, necesitamos descansar."],
                             :answer
                             ["Wollen Sie heute Abend weggehen? Nein danke, wir müssen uns ausruhen."]}
                      #:item{:n 9,
                             :prompt
                             ["¿Dónde van a pasar el verano? Este año vamos a pasar el verano en casa con la familia."],
                             :answer
                             ["Wo werden Sie den Sommer verbringen? Dieses Jahr werden wir den Sommer zu Hause mit der Familie verbringen."]}
                      #:item{:n 10,
                             :prompt ["Siempre me gusta comer aquí."],
                             :answer ["Ich esse hier immer gern."]}
                      #:item{:n 11,
                             :prompt
                             ["¿Quieren regresar a Puerto Nuevo para comer langosta? Si, queremos regresar pronto."],
                             :answer
                             ["Wollen Sie zurück nach Puerto Nuevo fahren, um Hummer zu essen? Ja, wir wollen bald zurückfahren."]}
                      #:item{:n 12,
                             :prompt
                             ["¿Quieren desayunar con nosotros mañana?"],
                             :answer
                             ["Wollen Sie morgen mit uns frühstücken?"]}
                      #:item{:n 13,
                             :prompt
                             ["Van a comprender más después de estudiar en México."],
                             :answer
                             ["Sie werden mehr verstehen, nachdem Sie in Mexiko gelernt haben."]}
                      #:item{:n 14,
                             :prompt
                             ["¿Cuándo van a llegar? Vamos a llegar esta noche."],
                             :answer
                             ["Wann werden Sie ankommen? Wir werden heute Abend ankommen."]}
                      #:item{:n 15,
                             :prompt
                             ["¿Pueden ayudarnos con el español?"],
                             :answer
                             ["Können Sie uns beim Spanischlernen helfen?"]}
                      #:item{:n 16,
                             :prompt ["Tienen que pagar a David."],
                             :answer ["Sie müssen David bezahlen."]}
                      #:item{:n 17,
                             :prompt
                             ["¿Por qué tienen que ir? Para trabajar."],
                             :answer
                             ["Warum müssen Sie gehen? Um zu arbeiten."]}
                      #:item{:n 18,
                             :prompt
                             ["¿Pueden pagar a Miguel por favor?"],
                             :answer
                             ["Können Sie Miguel bitte bezahlen?"]}
                      #:item{:n 19,
                             :prompt ["¿Quieren descansar un rato?"],
                             :answer
                             ["Wollen Sie sich eine Weile ausruhen?"]}
                      #:item{:n 20,
                             :prompt ["¿Cuándo necesitamos pagar?"],
                             :answer ["Wann müssen wir bezahlen?"]}
                      #:item{:n 21,
                             :prompt
                             ["Si van a regresar, tienen que visitarnos."],
                             :answer
                             ["Wenn Sie zurückkommen, müssen Sie uns besuchen."]}
                      #:item{:n 22,
                             :prompt
                             ["Pueden terminar ahora si quieren."],
                             :answer
                             ["Sie können jetzt fertig werden, wenn Sie wollen."]}
                      #:item{:n 23,
                             :prompt
                             ["Siempre van a encontrarnos aquí."],
                             :answer
                             ["Sie werden uns hier immer finden."]}],
                     :notes []}]}
