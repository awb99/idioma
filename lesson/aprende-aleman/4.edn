 :lesson/title "Palabras para el tiempo en alemán",
 :lesson/target-title "Wörter für die Zeit",
 :lesson/label "Lección 4",
 :lesson/sections
 [{:section/type :communication-multiplied,
   :section/id nil,
   :section/title "Palabras de tiempo y preposiciones",
   :section/body
   ["Las palabras de tiempo suelen llevar artículo o preposición: diese Woche, nächste Woche, am Morgen."
    "En alemán el artículo cambia según el caso: die Woche, der Tag, das Jahr."
    "Por la noche se dice in der Nacht o nachts; por la mañana, am Morgen."
    "Con diese y nächste no necesitas preposición: diese Woche, nächste Woche."]}],
 :lesson/number 4,
 :lesson/intro [],
 :lesson/step {:step/number 1, :step/title "Primeros pasos para hablar alemán"},
 :lesson/closing
 ["Ya tienes las palabras para moverte por el día, la semana y el mes."
  "Úsalas en frases completas: Ich werde diese Woche arbeiten."
  "La práctica constante hará que las uses sin pensar."],
