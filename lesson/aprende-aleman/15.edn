         :title "Verbos irregulares y pronombres",
         :target-title "Unregelmäßige Verben und Pronomen",
         :label "Lección 15",
         :sections
         [#:section{:type :accuracy-pointer,
                    :id 12,
                    :title "Verbos irregulares",
                    :body
                    ["En alemán muchos verbos cambian la vocal en la segunda y tercera persona del singular: ich fahre, du fährst, er fährt."
                     "Los verbos modales cambian todavía más: ich kann, du kannst, er kann; ich muss, du musst, er muss."
                     "En plural la forma es regular: wir können, wir müssen, sie können."
                     "Recuerda los verbos irregulares más importantes: sein (ich bin, du bist, er ist), haben (ich habe, du hast, er hat) y werden (ich werde, du wirst, er wird)."]}
          #:section{:type :communication-multiplied,
                    :id 12,
                    :title "Usted quiere vernos",
                    :body
                    ["El pronombre de objeto va después del verbo conjugado: Sie wollen uns sehen."
                     "uns = nos; mich = me; ihn = lo; sie = la; sie = los/las."
                     "La estructura es: sujeto + verbo modal + pronombre + infinitivo al final."
                     "Sie wollen uns sehen = usted quiere vernos."]}],
         :number 15,
         :intro [],
         :step #:step{:number 3, :title "Hablemos de nosotros"},
         :closing [],
