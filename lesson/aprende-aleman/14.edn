         [#:section{:type :accuracy-pointer,
                    :id 11,
                    :title "Wir möchten",
                    :body
                    ["En alemán, «nos gustaría» se expresa con möchten: ich möchte, wir möchten."
                     "La estructura es: sujeto + möchten + complemento + infinitivo al final."
                     "Wir möchten Deutsch lernen = nos gustaría aprender alemán."
                     "No digas *wir möchten lernen Deutsch*: el infinitivo va al final de la oración."]}],
         :number 14,
         :intro [],
         :step #:step{:number 3, :title "Hablemos de nosotros"},
         :closing [],
