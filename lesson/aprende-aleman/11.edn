                     :notes []}
          #:exercise{:id "11B",
                     :skill :translate,
                     :direction :to-base,
                     :dialog? false,
                     :instructions "Traduce estas frases al español.",
                     :hints ["esposo = der Ehemann"],
                     :items
                     [#:item{:n 1,
                             :prompt
                             ["Sie müssen mehr Spanisch lernen, um mit ihm zu sprechen."],
                             :answer
                             ["Tiene que aprender más español para hablar con él."]}
                      #:item{:n 2,
                             :prompt
                             ["Können Sie heute Nachmittag hier sein?"],
                             :answer ["¿Puede estar aquí esta tarde?"]}
                      #:item{:n 3,
                             :prompt
                             ["Können Sie mir heute Abend mit dem Spanischen helfen?"],
                             :answer
                             ["¿Puede ayudarme con el español esta noche?"]}
                      #:item{:n 4,
                             :prompt
                             ["Ich möchte heute Nachmittag den Dom besuchen."],
                             :answer
                             ["Me gustaría visitar la catedral esta tarde."]}
                      #:item{:n 5,
                             :prompt
                             ["Können Sie am Nachmittag arbeiten?"],
                             :answer ["¿Puede trabajar en la tarde?"]}
                      #:item{:n 6,
                             :prompt
                             ["Sie müssen jeden Tag mit David lernen."],
                             :answer
                             ["Tiene que estudiar con David cada día."]}
                      #:item{:n 7,
                             :prompt
                             ["Können Sie heute Nachmittag mit ihm zum Zahnarzt gehen?"],
                             :answer
                             ["¿Puede ir con él al dentista esta tarde?"]}
                      #:item{:n 8,
                             :prompt
                             ["Warum müssen Sie mit ihm zur Schule gehen? Um die Lehrerin zu sehen."],
                             :answer
                             ["¿Por qué tiene que ir con él a la escuela? Para ver a la maestra."]}
                      #:item{:n 9,
                             :prompt
                             ["Sie können mit Miguel lernen. Ja, ich werde jeden Nachmittag mit ihm in der Cafeteria lernen."],
                             :answer
                             ["Puede estudiar con Miguel. Sí, voy a estudiar con él cada tarde en la cafetería."]}
                      #:item{:n 10,
                             :prompt
                             ["Sie müssen Ihren Mann anrufen. Ja, ich werde ihn sofort anrufen."],
                             :answer
                             ["Tiene que llamar a su esposo. Sí, voy a llamarlo ahora mismo."]}
                      #:item{:n 11,
                             :prompt
                             ["Können Sie jetzt aufhören? Nein, ich muss weitermachen."],
                             :answer
                             ["¿Puede terminar ahora? No, tengo que continuar."]}
                      #:item{:n 12,
                             :prompt
                             ["Sie müssen mehr Spanisch mit ihm sprechen. Ja, ich werde jeden Tag mit ihm sprechen."],
                             :answer
                             ["Necesita hablar más español con él. Sí, voy a hablar con él cada día."]}
                      #:item{:n 13,
                             :prompt
                             ["Möchten Sie heute Nachmittag mit ihm Fußball im Fernsehen sehen? Es tut mir leid, ich muss heute Nachmittag arbeiten."],
                             :answer
                             ["¿Le gustaría ver el fútbol por televisión con él esta tarde? Lo siento, necesito trabajar esta tarde."]}
                      #:item{:n 14,
                             :prompt
                             ["Können Sie am Nachmittag zurückkommen? Nein, ich kann erst morgen Nachmittag zurückkommen."],
                             :answer
                             ["¿Puede regresar en la tarde? No, no puedo regresar hasta mañana en la tarde."]}
                      #:item{:n 15,
                             :prompt
                             ["Können Sie sie heute besuchen? Ja, ich werde sie heute Nachmittag besuchen."],
                             :answer
                             ["¿Puede visitarla hoy? Sí, voy a visitarla esta tarde."]}
                      #:item{:n 16,
                             :prompt
                             ["Können Sie morgen wieder arbeiten? Nein, ich kann nur bis heute Nachmittag arbeiten."],
                             :answer
                             ["¿Puede trabajar otra vez mañana? No, sólo puedo trabajar hasta esta tarde."]}
                      #:item{:n 17,
                             :prompt
                             ["Möchten Sie jetzt gehen? Nein, zuerst möchte ich diesen Kaffee austrinken."],
                             :answer
                             ["¿Le gustaría ir ahora? No, primero quiero terminar este café"]}
                      #:item{:n 18,
                             :prompt
                             ["Werden Sie mit ihm dorthin gehen? Ja, ich werde sofort gehen."],
                             :answer
                             ["¿Va a ir allá con él? Sí, voy a ir ahora mismo."]}],
                     :notes []}
