   [{:item/n 1,
     :item/prompt ["Vielleicht können Sie mit ihnen Spanisch üben."],
     :item/answer ["Tal vez ustedes pueden practicar el español con ellos."]}
    {:item/n 2,
     :item/prompt
     ["Sie müssen mehr Spanisch lernen, um mit uns sprechen zu können."
      "Ja, sie werden Privatunterricht nehmen."],
     :item/answer
     ["Ellos necesitan aprender más español para hablar con nosotros."
      "Si, van a estudiar en clases privadas."]}
    {:item/n 3,
     :item/prompt ["Sie brauchen ein Taxi." "Ich werde ihnen sofort ein Taxi rufen."],
     :item/answer ["Ellas necesitan un taxi." "Voy a llamar un taxi para ellas ahora mismo."]}
    {:item/n 4,
     :item/prompt ["Viele Mexikaner essen nach dem Tanzen gern Tacos."],
     :item/answer ["A muchos mexicanos les gusta comer tacos después de salir a bailar."]}
    {:item/n 5,
     :item/prompt
     ["Die Studenten wollen ihren Lehrer nicht zur Party einladen."
      "Warum wollen sie ihn nicht einladen?"
      "Weil sie den Lehrer nicht mögen."],
     :item/answer
     ["Los estudiantes no quieren invitar a su maestro a la fiesta."
      "¿Por qué no quieren invitarlo?"
      "Porque no les gusta el maestro."]}
    {:item/n 6,
     :item/prompt
     ["Sie wollen in ein typisches Restaurant gehen; sie würden gern die traditionelle Küche dieser Gegend probieren."],
     :item/answer
     ["Ellas quieren ir a un restaurante típico, les gustaría probar la comida tradicional de aquí."]}
    {:item/n 7,
     :item/prompt ["Er wird fast sein ganzes Geld ausgeben."],
     :item/answer ["Él va a gastar casi todo su dinero."]}
    {:item/n 8,
     :item/prompt ["Niemand will mit mir gehen."],
     :item/answer ["Nadie quiere ir conmigo."]}
    {:item/n 9,
     :item/prompt ["Schmeckt ihnen das Essen?" "Ja, sie lieben das Essen."],
     :item/answer ["¿A ellos les gusta la comida?" "Sí, ellos les encanta la comida."]}
    {:item/n 10,
     :item/prompt ["Wer kann Lisa helfen?" "Niemand kann ihr heute helfen."],
     :item/answer ["¿Quién puede ayudar a Lisa?" "Nadie puede ayudarla hoy."]}
    {:item/n 11,
     :item/prompt ["Sie kann die ganze Nacht sprechen, ohne zu atmen."],
     :item/answer ["Ella puede hablar toda la noche sin respirar."]}
    {:item/n 12,
     :item/prompt ["Ich möchte fast alle Gerichte auf der Speisekarte probieren."],
     :item/answer ["Quiero probar casi toda la comida en el menú."]}
    {:item/n 13,
     :item/prompt ["Die Firma wird fast alle Kosten bezahlen."],
     :item/answer ["La compañía va a pagar casi todos los costos."]}
    {:item/n 14,
     :item/prompt ["Er wird eine Stunde sprechen."],
     :item/answer ["Él va a hablar por una hora."]}
    {:item/n 15,
     :item/prompt ["Sie würden gern mit Ihnen sprechen."],
     :item/answer ["A ellos les gustaría hablar con ustedes."]}
    {:item/n 16,
     :item/prompt ["Ich würde gern mehr Spanisch mit Ihnen sprechen können."],
     :item/answer ["Me gustaría poder hablar más español con ustedes."]}
    {:item/n 17,
     :item/prompt ["Es tut mir leid, ich will nicht mehr mit Ihnen arbeiten."],
     :item/answer ["Lo siento, no quiero trabajar más con ustedes."]}
    {:item/n 18,
     :item/prompt ["Sie müssen mehr Spanisch lernen, um mit ihm sprechen zu können."],
     :item/answer ["Tienen que aprender más español para poder hablar con él."]}
    {:item/n 19,
     :item/prompt
     ["Vielleicht können Sie mit Miguel lernen."
      "Ja, wir werden jeden Nachmittag mit ihm in der Cafeteria lernen."],
     :item/answer
     ["Tal vez ustedes pueden estudiar con Miguel."
