     :item/prompt ["¿A ellos les gusta México?" "Si, les encanta México."],
     :item/answer ["Gefällt ihnen Mexiko?" "Ja, sie lieben Mexiko."]}
    {:item/n 6,
     :item/prompt ["Vamos a desayunar con ellas mañana."],
     :item/answer ["Wir werden morgen mit ihnen frühstücken."]}
    {:item/n 7,
