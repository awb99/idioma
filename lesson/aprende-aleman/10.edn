         :label "Lección 10",
         :sections
         [#:section{:type :accuracy-pointer,
                    :id 8,
                    :title "Sie möchten",
                    :body
                    ["Sie möchten es la forma educada de decir Sie wollen."
                     "La estructura es: Sie möchten + infinitivo al final: Sie möchten Deutsch lernen."
                     "Con er, sie y es la forma es er möchte, sie möchte, es möchte."
                     "möchten lleva umlaut y en el trato formal nunca se convierte en möchtet."]}
          #:section{:type :communication-multiplied,
                    :id 9,
                    :title "Sie wollen mich sehen",
                    :body
                    ["El pronombre de objeto puede ir después del verbo: Sie wollen mich sehen."
                     "mich = me; Sie = le/les (formal); uns = nos; sie = los/las."
                     "La estructura es: sujeto + wollen + pronombre de objeto + infinitivo al final."
                     "Sie wollen mich sehen = quiere verme / quieren verme."]}],
         :number 10,
         :intro [],
         :step #:step{:number 2, :title "Aprender a usar el diálogo"},
