         :title "Fin del paso 3: repaso",
         :target-title "Ende von Schritt 3",
         :label "Lección 17",
         :sections
         [#:section{:type :accuracy-pointer,
                    :id 15,
                    :title "kennenlernen, kennen y wissen",
                    :body
                    ["En alemán hay varios verbos para «conocer»: kennenlernen es conocer a alguien por primera vez; kennen es conocer a alguien o algo."
                     "Para hechos y cosas se usa wissen: Ich weiß die Antwort."
                     "No uses wissen con personas: «Ich weiß Ana» sería incorrecto."
                     "Ich lerne meine Enkelin kennen = voy a conocer a mi nieta."]}
          #:section{:type :communication-multiplied,
                    :id 15,
                    :title "Wir wollen sie sehen",
                    :body
                    ["El pronombre de objeto directo de tercera persona plural es sie para masculino y femenino: Wir wollen sie sehen."
                     "En alemán sie puede significar «ella», «ellas» o «ellos»; el verbo y el contexto lo aclaran."
                     "La estructura es: sujeto + wollen + sie + infinitivo al final."
                     "Wir wollen sie sehen = queremos verlos o verlas."]}],
         :number 17,
         :intro [],
         :step #:step{:number 3, :title "Hablemos de nosotros"},
         :closing
         ["Enhorabuena, has terminado el paso 3."
          "Has cubierto muchísima estructura con muy pocas palabras."
          "Todavía quedan palabras y estructuras para ampliar tu comunicación."
          "Nos vemos en la lección 18."],
