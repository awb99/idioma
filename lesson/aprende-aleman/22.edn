          #:exercise{:id "22D",
                     :skill :translate,
                     :direction :to-target,
                     :dialog? false,
                     :instructions "Traduce estas frases al alemán.",
                     :hints
                     ["esposo = der Ehemann" "esposa = die Ehefrau"],
                     :items
                     [#:item{:n 1,
                             :prompt ["Quiero comer bien hoy."],
                             :answer ["Ich will heute gut essen."]}
                      #:item{:n 2,
                             :prompt
                             ["Lupita no va a poder visitarnos este invierno."],
                             :answer
                             ["Lupita wird uns diesen Winter nicht besuchen können."]}
                      #:item{:n 3,
                             :prompt
                             ["Usted va a hablar español muy bien pronto."],
                             :answer
                             ["Sie werden bald sehr gut Spanisch sprechen."]}
                      #:item{:n 4,
                             :prompt
                             ["George no puede leer muy bien."],
                             :answer
                             ["George kann nicht sehr gut lesen."]}
                      #:item{:n 5,
                             :prompt ["Usted va a vivir bien allá."],
                             :answer ["Sie werden dort gut leben."]}
                      #:item{:n 6,
                             :prompt
                             ["Ella no va a poder empezar hasta el invierno."],
                             :answer
                             ["Sie wird erst im Winter beginnen können."]}
                      #:item{:n 7,
                             :prompt
                             ["No quiero ir con él, no puede manejar muy bien."],
                             :answer
                             ["Ich will nicht mit ihm gehen. Er kann nicht sehr gut fahren."]}
                      #:item{:n 8,
                             :prompt
                             ["María no va a poder cenar con nosotros esta noche, tiene que trabajar."],
                             :answer
                             ["María wird heute Abend nicht mit uns zu Abend essen können, sie muss arbeiten."]}
                      #:item{:n 9,
                             :prompt
                             ["¿Puede esperarme después de trabajar? Lo siento, no voy a poder esperarla hoy."],
                             :answer
                             ["Können Sie nach der Arbeit auf mich warten? Es tut mir leid, ich werde heute nicht auf Sie warten können."]}
                      #:item{:n 10,
                             :prompt
                             ["Usted va a poder leer el español muy pronto."],
                             :answer
                             ["Sie werden sehr bald Spanisch lesen können."]}
                      #:item{:n 11,
                             :prompt ["Él no puede cantar muy bien."],
                             :answer
                             ["Er kann nicht sehr gut singen."]}
                      #:item{:n 12,
                             :prompt
                             ["Luís también va a poder ayudarnos."],
                             :answer
                             ["Luís wird uns auch helfen können."]}
                      #:item{:n 13,
                             :prompt
                             ["Teresa no va a poder regresar hasta el invierno."],
                             :answer
                             ["Teresa wird erst im Winter zurückkommen können."]}
                      #:item{:n 14,
                             :prompt
                             ["El doctor va a poder verlo mañana."],
                             :answer
                             ["Der Arzt wird Sie morgen sehen können."]}
                      #:item{:n 15,
                             :prompt
                             ["No voy a poder estudiar este fin de semana."],
                             :answer
                             ["Ich werde dieses Wochenende nicht lernen können."]}
                      #:item{:n 16,
                             :prompt
                             ["Jenny no va a poder llamarme hasta la próxima semana."],
                             :answer
                             ["Jenny wird mich erst nächste Woche anrufen können."]}
                      #:item{:n 17,
                             :prompt
                             ["John va a poder aprender mucho español allá."],
                             :answer
                             ["John wird dort viel Spanisch lernen können."]}
                      #:item{:n 18,
                             :prompt
                             ["Sara no quiere ir a la fiesta."],
                             :answer
                             ["Sara will nicht auf die Party gehen."]}
                      #:item{:n 19,
                             :prompt ["Juan quiere hablar con usted."],
                             :answer ["Juan will mit Ihnen sprechen."]}
                      #:item{:n 20,
                             :prompt
                             ["Mi esposa también quiere ir a Europa este año."],
                             :answer
                             ["Meine Frau will dieses Jahr auch nach Europa fahren."]}
                      #:item{:n 21,
                             :prompt
                             ["Él va a estudiar español en Guatemala en el verano."],
                             :answer
                             ["Er wird im Sommer Spanisch in Guatemala studieren."]}
                      #:item{:n 22,
                             :prompt
                             ["Mi mamá va a viajar a España y también a Argentina."],
                             :answer
                             ["Meine Mutter wird nach Spanien und auch nach Argentinien reisen."]}
                      #:item{:n 23,
                             :prompt
                             ["Él va a estar en casa esta noche."],
                             :answer
                             ["Er wird heute Abend zu Hause sein."]}
                      #:item{:n 24,
                             :prompt
                             ["Él va a invitar a Ana a la fiesta."],
                             :answer
                             ["Er wird Ana zur Party einladen."]}
                      #:item{:n 25,
                             :prompt ["Jorge quiere ayudarnos."],
                             :answer ["Jorge will uns helfen."]}
                      #:item{:n 26,
                             :prompt ["Ella va a llamarnos mañana."],
                             :answer ["Sie wird uns morgen anrufen."]}
                      #:item{:n 27,
                             :prompt
                             ["Mi amigo va a pasar el invierno en nuestra casa."],
                             :answer
                             ["Mein Freund wird den Winter in unserem Haus verbringen."]}
                      #:item{:n 28,
                             :prompt
                             ["Mi esposa quiere viajar a Paris."],
                             :answer
                             ["Meine Frau will nach Paris reisen."]}
                      #:item{:n 29,
                             :prompt
                             ["Mi esposo también tiene que manejar mucho cada día."],
                             :answer
                             ["Mein Mann muss auch jeden Tag viel fahren."]}],
                     :notes []}]}
