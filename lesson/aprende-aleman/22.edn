         :title "Él, ella y usted en alemán",
         :target-title "Er, sie und Sie",
         :label "Lección 22",
         :sections
         [#:section{:type :communication-multiplied,
                    :id 19,
                    :title "Él, ella y usted",
                    :body
                    ["En alemán el verbo cambia en la tercera persona del singular: er arbeitet, sie braucht."
                     "Las formas er, sie y es comparten la misma conjugación: er singt, sie singt, es singt."
                     "El Sie formal usa la misma forma verbal que sie (ellos/ellas): Sie arbeiten."
                     "A diferencia del español, el pronombre sujeto casi siempre se usa: Er kommt heute."]}],
         :number 22,
         :intro [],
         :step #:step{:number 5, :title "Hablar de otras personas"},
         :closing [],
         :exercises
         [#:exercise{:id "22A",
                     :skill :recall,
                     :direction :to-base,
                     :dialog? false,
                     :instructions
                     "Escribe en español las palabras que corresponden a cada expresión en alemán.",
                     :hints [],
                     :items
                     [#:item{:n 1,
                             :prompt
                             ["Las palabras en español para “gut” son"],
                             :answer ["bien"]}
                      #:item{:n 2,
                             :prompt
                             ["Las palabras en español para “der Winter” son"],
                             :answer ["invierno"]}
                      #:item{:n 3,
                             :prompt
                             ["Las palabras en español para “auch” son"],
                             :answer ["también"]}
                      #:item{:n 4,
                             :prompt
                             ["Las palabras en español para “sehr” son"],
                             :answer ["muy"]}
                      #:item{:n 5,
                             :prompt
                             ["Las palabras en español para “können” son"],
                             :answer ["poder"]}
                      #:item{:n 6,
                             :prompt
                             ["Las palabras en español para “singen” son"],
                             :answer ["cantar"]}],
                     :notes []}
          #:exercise{:id "22B",
                     :skill :translate,
                     :direction :to-base,
                     :dialog? false,
                     :instructions "Traduce estas frases al español.",
                     :hints
                     ["laut = fuerte"
                      "Gott = Dios"
                      "Tochter = hija"
                      "so viele = tantos"
                      "Ständchen = serenata"
                      "Ihr/dein/sein/ihr = su"],
                     :items
                     [#:item{:n 1,
                             :prompt
                             ["Auch Sie müssen etwas für Antonio kaufen."],
                             :answer
                             ["También usted necesita comprar algo para Antonio."]}
                      #:item{:n 2,
                             :prompt
                             ["Sie müssen lauter sprechen, ich kann Sie nicht sehr gut hören."],
                             :answer
                             ["Usted necesita hablar más fuerte,no puedo escucharlo muy bien."]}
                      #:item{:n 3,
                             :prompt
                             ["Mit Gottes Hilfe wird sie gut ankommen."],
                             :answer
                             ["Con el favor de Dios, ella va a llegar bien."]}
                      #:item{:n 4,
                             :prompt ["Er wird in der Bar singen."],
                             :answer ["Él va a cantar en el bar."]}
                      #:item{:n 5,
                             :prompt
                             ["Er wird nicht mit meiner Tochter ausgehen können."],
                             :answer
                             ["Él no va a poder salir con mi hija."]}
                      #:item{:n 6,
                             :prompt
                             ["David möchte auch in einer Rockband singen."],
                             :answer
                             ["David también quiere cantar en un grupo de rock."]}
                      #:item{:n 7,
                             :prompt
                             ["Er wird ein Jahr in Südamerika arbeiten."],
                             :answer
                             ["Él va a trabajar en Sudamérica por un año."]}
                      #:item{:n 8,
                             :prompt
                             ["Ich werde erst nächsten Monat zahlen können."],
                             :answer
                             ["No voy a poder pagar hasta el próximo mes."]}
                      #:item{:n 9,
                             :prompt
                             ["Alejandro möchte auch das Konzert sehen."],
                             :answer
                             ["Alejandro también quiere ver el concierto."]}
                      #:item{:n 10,
                             :prompt
                             ["Ich werde das nicht vergessen können."],
                             :answer ["No voy a poder olvidar esto."]}
                      #:item{:n 11,
                             :prompt
                             ["Noel möchte uns zum Abendessen zu sich nach Hause einladen."],
                             :answer
                             ["Noel quiere invitarnos a cenar en su casa."]}
                      #:item{:n 12,
                             :prompt
                             ["Er wird singen, um der Señorita ein Ständchen zu bringen."],
                             :answer
                             ["Él va a cantar para dar una serenata a la señorita."]}
                      #:item{:n 13,
                             :prompt
                             ["Wir müssen das Geburtstagslied singen."],
                             :answer
                             ["Tenemos que cantar \"Happy Birthday\"."]}
                      #:item{:n 14,
                             :prompt
                             ["Ich singe nicht gern in der Öffentlichkeit."],
                             :answer
                             ["No me gusta cantar en público."]}
                      #:item{:n 15,
                             :prompt
                             ["Wir werden den Unterricht nicht beginnen können, wir brauchen mehr Schüler."],
                             :answer
                             ["No vamos a poder empezar la clase, necesitamos más estudiantes."]}
                      #:item{:n 16,
                             :prompt
                             ["Sie werden nach so vielen Tequilas nicht fahren können."],
                             :answer
                             ["Usted no va a poder manejar después de tomar tantos tequilas."]}
                      #:item{:n 17,
                             :prompt
                             ["Wir müssen auch sehr bald gehen."],
                             :answer
                             ["Tenemos que ir muy pronto también."]}
                      #:item{:n 18,
                             :prompt
                             ["Ich kann keinen Tequila trinken, es ist noch sehr früh zum Trinken."],
                             :answer
                             ["No puedo tomar un tequila, es muy temprano para tomar."]}
                      #:item{:n 19,
                             :prompt
                             ["Wir werden erst in Mulegé Benzin kaufen können."],
                             :answer
                             ["No vamos a poder comprar gasolina hasta Mulege."]}
                      #:item{:n 20,
                             :prompt
                             ["Ich werde im Restaurant nicht viel Geld ausgeben können."],
                             :answer
                             ["No voy a poder gastar mucho dinero en el restaurante."]}
                      #:item{:n 21,
                             :prompt
                             ["Wann muss ich zurückkommen? Sie müssen vor Mitternacht zurückkommen."],
                             :answer
                             ["¿Cuándo tengo que regresar? Tiene que regresar antes de media noche."]}
                      #:item{:n 22,
                             :prompt
                             ["Meine Mutter wird im Winter in Mexiko Urlaub machen."],
                             :answer
                             ["Mi mamá va a vacacionar en México en invierno."]}
                      #:item{:n 23,
                             :prompt
                             ["Sie wird uns mein Lieblingsgericht kochen."],
                             :answer
                             ["Ella va a cocinarnos mi plato favorito."]}
                      #:item{:n 24,
                             :prompt
                             ["Der Lehrer wird den Kurs im Mai beenden."],
                             :answer
                             ["El maestro va a terminar el curso en mayo."]}],
                     :notes []}
          #:exercise{:id "22C",
                     :skill :recall,
