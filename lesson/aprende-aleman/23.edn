 :lesson/label "Lección 23",
 :lesson/sections
 [{:section/type :accuracy-pointer,
   :section/id 18,
   :section/title "Todos los días / el día entero",
   :section/body
   ["«todos los días» = jeden Tag; «el día entero» = den ganzen Tag."
    "«cada» + sustantivo singular: jede Woche, jeden Monat."
    "«todo» + sustantivo plural o incontable: alle meine Freunde, die ganze Zeit."
    "En alemán «jeden Tag» se escribe separado."]}
  {:section/type :communication-multiplied,
   :section/id 20,
   :section/title "¿Le gustaría a él...?",
   :section/body
   ["«¿Le gustaría un café?» = Möchte er einen Kaffee?"
    "«möchten» cambia con la persona: er möchte, sie möchte, Sie möchten."
    "Para preguntar, el verbo modal va delante: Möchte er ...?"
    "Para negar: Er möchte keinen Kaffee. / Er möchte nicht ..."]}],
 :lesson/number 23,
