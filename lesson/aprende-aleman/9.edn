          #:exercise{:id "9E",
                     :skill :translate,
                     :direction :to-target,
                     :dialog? true,
                     :instructions
                     "Traduce cada intervención del diálogo al alemán.",
                     :hints [],
                     :items
                     [#:item{:n 1,
                             :prompt
                             ["¿Cuándo necesita ver al doctor?"
                              "Mañana."],
                             :answer
                             ["Wann müssen Sie zum Arzt gehen?"
                              "Morgen."]}
                      #:item{:n 2,
                             :prompt
                             ["¿Cuándo necesita ir?"
                              "Necesito ir mañana."],
                             :answer
                             ["Wann müssen Sie gehen?"
                              "Ich muss morgen gehen."]}
                      #:item{:n 3,
                             :prompt
                             ["¿Cuándo quiere comer?"
                              "Quiero comer ahora."],
                             :answer
                             ["Wann wollen Sie essen?"
                              "Ich möchte jetzt essen."]}
                      #:item{:n 4,
                             :prompt
                             ["¿Quiere ver mi casa?"
                              "Sí, me gustaría ver su casa."],
                             :answer
                             ["Wollen Sie mein Haus sehen?"
                              "Ja, ich möchte Ihr Haus sehen."]}
                      #:item{:n 5,
                             :prompt
                             ["¿Cuándo necesita regresar a su casa?"
                              "Necesito regresar mañana en la noche."],
                             :answer
                             ["Wann müssen Sie nach Hause zurückkehren?"
                              "Ich muss morgen Abend zurückkehren."]}
                      #:item{:n 6,
                             :prompt
                             ["¿Quiere comer en mi casa, o quiere comer en un restaurante?"
                              "Me gustaría mucho comer en su casa."],
                             :answer
                             ["Wollen Sie in meinem Haus essen oder wollen Sie in einem Restaurant essen?"
                              "Ich möchte sehr gern in Ihrem Haus essen."]}
                      #:item{:n 7,
                             :prompt
                             ["¿Quiere ir a Tijuana esta noche?"
                              "No, no me gusta ir a Tijuana en la noche."],
                             :answer
                             ["Wollen Sie heute Abend nach Tijuana fahren?"
                              "Nein, ich fahre nicht gern nachts nach Tijuana."]}
                      #:item{:n 8,
                             :prompt
                             ["¿Quiere más?"
                              "No, no quiero más, gracias."],
                             :answer
                             ["Wollen Sie mehr?"
                              "Nein, ich möchte nicht mehr, danke."]}
                      #:item{:n 9,
                             :prompt
                             ["Necesita ayudar a su papá mañana."
                              "No puedo, tengo que ir al doctor."],
                             :answer
                             ["Sie müssen morgen Ihrem Vater helfen."
                              "Ich kann nicht, ich muss zum Arzt gehen."]}
                      #:item{:n 10,
                             :prompt
                             ["¿Quiere visitar México otra vez?"
                              "Sí, quiero regresar el próximo año"],
                             :answer
                             ["Wollen Sie Mexiko wieder besuchen?"
                              "Ja, ich möchte nächstes Jahr zurückkehren."]}
                      #:item{:n 11,
                             :prompt
                             ["¿Quiere ir a una fiesta en mi casa el próximo fin de semana?"
                              "Sí, me gustaría ir pero no puedo."],
                             :answer
                             ["Wollen Sie nächstes Wochenende auf eine Party in meinem Haus gehen?"
                              "Ja, ich möchte gehen, aber ich kann nicht."]}
                      #:item{:n 12,
                             :prompt
                             ["¿Necesita ir a México?"
                              "Sí, tengo que ir mañana."],
                             :answer
                             ["Müssen Sie nach Mexiko fahren?"
                              "Ja, ich muss morgen fahren."]}
                      #:item{:n 13,
                             :prompt
                             ["¿Quiere ir a un restaurante conmigo?"
                              "Sí, me gustaría ir con usted."],
                             :answer
                             ["Wollen Sie mit mir in ein Restaurant gehen?"
                              "Ja, ich möchte mit Ihnen gehen."]}
                      #:item{:n 14,
                             :prompt
                             ["¿Quiere comer conmigo en el restaurante esta noche?"
                              "Sí, me gustaría mucho comer con usted."],
                             :answer
                             ["Wollen Sie heute Abend mit mir im Restaurant essen?"
                              "Ja, ich möchte sehr gern mit Ihnen essen."]}
                      #:item{:n 15,
                             :prompt
                             ["Necesita ir conmigo para ver a mi mamá."
                              "Sí, voy a ir con usted."],
                             :answer
                             ["Sie müssen mit mir gehen, um meine Mutter zu sehen."
                              "Ja, ich werde mit Ihnen gehen."]}
                      #:item{:n 16,
                             :prompt
                             ["¿Quiere regresar conmigo?"
                              "Gracias, pero voy a regresar con Mario."],
                             :answer
                             ["Wollen Sie mit mir zurückkehren?"
                              "Danke, aber ich werde mit Mario zurückkehren."]}
                      #:item{:n 17,
                             :prompt
                             ["Necesita trabajar conmigo hoy."
                              "Sí, voy a trabajar con usted."],
                             :answer
                             ["Sie müssen heute mit mir arbeiten."
                              "Ja, ich werde mit Ihnen arbeiten."]}
                      #:item{:n 18,
                             :prompt
                             ["¿Quiere pasar el fin de semana conmigo en México?"
                              "Lo siento, pero no puedo, tengo que trabajar."],
                             :answer
                             ["Wollen Sie das Wochenende mit mir in Mexiko verbringen?"
                              "Es tut mir leid, aber ich kann nicht, ich muss arbeiten."]}],
                     :notes []}]}
